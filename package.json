{
  "name": "daliymove-tech-share",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "links": "node scripts/check-links.mjs",
    "contracts": "node scripts/check-site-contract.mjs",
    "content:seo": "node scripts/check-content-seo.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/check-lighthouse.mjs",
    "quality": "pnpm build && pnpm test:e2e && pnpm test:lighthouse",
    "audit": "pnpm audit --audit-level=critical",
    "audit:report": "pnpm audit --audit-level=moderate",
    "verify": "pnpm content:seo && pnpm build && pnpm links && pnpm contracts"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.7",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "12.8.2",
    "typescript": "5.9.3"
  }
}
