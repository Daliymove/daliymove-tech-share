---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="qs-page-head">
  {eyebrow && <p class="qs-eyebrow">{eyebrow}</p>}
  <h1 class="qs-page-title">{title}</h1>
  {description && <p class="qs-page-desc">{description}</p>}
</header>
<hr class="qs-rule" />
