---
import { formatDate, getCategoryUrl, getPostUrl, getReadingTime, getTagUrl, type BlogPost } from "../lib/posts";

interface Props {
  post: BlogPost;
  emphasized?: boolean;
  compact?: boolean;
  showDate?: boolean;
}

const { post, emphasized = false, compact = false, showDate = true } = Astro.props;
const postUrl = getPostUrl(post);
const dateLabel = new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" }).format(post.data.pubDate).replace("/", ".");
---

<article class:list={["post-row group", emphasized && "post-row-emphasis"]}>
  <div class="post-row-date">
    {showDate ? (
      <time datetime={post.data.pubDate.toISOString()} aria-label={`发布时间：${formatDate(post.data.pubDate)}`}>{dateLabel}</time>
    ) : (
      <span>{post.data.category}</span>
    )}
  </div>

  <div class="post-row-body">
    <h2 class="post-row-title"><a href={postUrl}>{post.data.title}</a></h2>
    {!compact && <p class="post-row-desc">{post.data.description}</p>}
    <div class="post-row-meta">
      <a class="qs-plain-link" href={getCategoryUrl(post.data.category)}>{post.data.category}</a>
      {post.data.pinned && <span>置顶</span>}
      <span>{getReadingTime(post.body)}</span>
      {post.data.series && <span>系列 · {post.data.series}</span>}
      {!compact && post.data.tags.slice(0, 2).map((tag) => <a class="qs-plain-link" href={getTagUrl(tag)}>#{tag}</a>)}
    </div>
  </div>

  <span class="post-row-side" aria-hidden="true">阅读 →</span>
</article>
