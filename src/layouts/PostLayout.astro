---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import {
  formatDate,
  absoluteUrl,
  getAdjacentPosts,
  getAllPosts,
  getCategoryUrl,
  getCoverUrl,
  getOgImageAbsoluteUrl,
  getOgImageUrl,
  getPostAbsoluteUrl,
  getPostUrl,
  getReadingTime,
  getRelatedPosts,
  getTagUrl,
  withBase,
  type BlogPost,
} from "../lib/posts";
import { site } from "../lib/site";

interface Props {
  post: BlogPost;
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { post, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const posts = await getAllPosts();
const { prev, next } = getAdjacentPosts(posts, post);
const related = getRelatedPosts(posts, post, 3);
const cover = getCoverUrl(post);
const ogImage = getOgImageUrl(post);
const articleUrl = getPostAbsoluteUrl(post);
const breadcrumbStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "文章", item: absoluteUrl("/blog/") },
    { "@type": "ListItem", position: 3, name: post.data.title, item: articleUrl },
  ],
}).replace(/</g, "\\u003c");
const articleStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: articleUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  inLanguage: "zh-CN",
  articleSection: post.data.category,
  ...(post.data.tags.length ? { keywords: post.data.tags.join(", ") } : {}),
  image: {
    "@type": "ImageObject",
    url: getOgImageAbsoluteUrl(post),
    caption: post.data.title,
  },
  author: {
    "@type": "Person",
    name: site.author,
    url: site.github,
    sameAs: [site.github],
  },
  isPartOf: {
    "@type": "Blog",
    name: site.title,
    url: site.url,
  },
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  imageAlt={`文章分享图：${post.data.title}`}
  type="article"
  articlePublishedTime={post.data.pubDate.toISOString()}
  articleModifiedTime={post.data.updatedDate?.toISOString()}
  articleSection={post.data.category}
  articleTags={post.data.tags}
  canonicalPath={`/blog/${post.id.replace(/\.(md|mdx)$/i, "").replace(/\/index$/, "")}/`}
>
  <script is:inline type="application/ld+json" set:html={articleStructuredData}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbStructuredData}></script>
  <article class:list={["grid gap-8 lg:gap-16", toc.length > 0 && "lg:grid-cols-[14rem_minmax(0,1fr)] xl:gap-20"]} data-pagefind-body data-reading-article>
    {toc.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-28 text-sm">
          <div data-reveal="soft">
            <p class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-ink-600 dark:text-ink-200">
              <Icon name="layers" class="h-3.5 w-3.5" />
              本页目录
            </p>
            <nav class="max-h-[calc(100vh-11rem)] space-y-2.5 overflow-y-auto pr-2" data-toc-nav>
              {toc.map((heading) => (
                <a class:list={["toc-link block leading-5 text-ink-600 transition hover:text-leaf-700 dark:text-ink-200 dark:hover:text-leaf-300", heading.depth === 3 ? "pl-2 text-xs font-medium" : "font-semibold"]} href={`#${heading.slug}`} data-toc-slug={heading.slug}>{heading.text}</a>
              ))}
            </nav>
          </div>
        </div>
      </aside>
    )}
    <div class="min-w-0">
      <a class="inline-flex items-center gap-2 text-sm font-medium text-ink-500 transition hover:text-leaf-700 dark:text-ink-300 dark:hover:text-leaf-300" href={withBase("/blog/")}>
        <span aria-hidden="true">←</span>
        返回文章列表
      </a>
      <header class="mt-6 border-b border-ink-200/70 pb-9 dark:border-white/10" data-reveal>
        <div class="flex flex-wrap items-center gap-2">
          <a class="inline-flex items-center gap-1 rounded-full border border-leaf-200 bg-leaf-50 px-3 py-1 text-xs font-semibold text-leaf-700 dark:border-leaf-300/20 dark:bg-leaf-300/10 dark:text-leaf-100" href={getCategoryUrl(post.data.category)}>
            <Icon name="grid" class="h-3 w-3" />
            {post.data.category}
          </a>
          {post.data.series && (
            <span class="inline-flex items-center gap-1 rounded-full border border-bark-300/40 bg-bark-100 px-3 py-1 text-xs font-semibold text-bark-700 dark:border-bark-300/25 dark:bg-bark-500/15 dark:text-bark-300">
              <Icon name="layers" class="h-3 w-3" />
              系列 · {post.data.series}
            </span>
          )}
          {post.data.pinned && (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/70 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 shadow-sm dark:border-amber-300/25 dark:bg-amber-300/10 dark:text-amber-100">
              <Icon name="pin" class="h-3 w-3" />
              置顶文章
            </span>
          )}
        </div>
        <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight tracking-normal text-ink-950 dark:text-white md:text-5xl" data-pagefind-meta="title" data-article-title tabindex="-1">{post.data.title}</h1>
        <p class="mt-4 text-base leading-7 text-ink-600 dark:text-ink-300">{post.data.description}</p>
        {post.data.pinned && (
          <p class="mt-5 inline-flex items-center gap-2 rounded-xl border border-amber-200/80 bg-amber-50/80 px-3.5 py-2 text-sm text-amber-800 dark:border-amber-300/20 dark:bg-amber-300/10 dark:text-amber-100">
            <Icon name="pin" class="h-4 w-4 shrink-0" />
            这是一篇置顶文章，作为当前阶段的优先阅读内容。
          </p>
        )}
        <div class="mt-7 flex flex-wrap items-center gap-3 text-sm text-ink-500 dark:text-ink-300">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span class="text-ink-300 dark:text-ink-600">/</span>
          <span class="inline-flex items-center gap-1">
            <Icon name="book" class="h-3.5 w-3.5" />
            {getReadingTime(post.body)}
          </span>
          {post.data.updatedDate && (
            <>
              <span class="text-ink-300 dark:text-ink-600">/</span>
              <span>更新于 {formatDate(post.data.updatedDate)}</span>
            </>
          )}
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a class="rounded-full bg-ink-100/80 px-3 py-1 text-sm text-ink-600 transition hover:bg-leaf-100 hover:text-leaf-700 dark:bg-white/10 dark:text-ink-200 dark:hover:bg-leaf-300/10" href={getTagUrl(tag)}>#{tag}</a>
          ))}
        </div>
        <div class:list={["mt-8 grid gap-4", cover && "lg:grid-cols-[minmax(0,1fr)_17rem]"]}>
          {cover && (
            <div class="overflow-hidden rounded-[1.35rem] border border-white/70 bg-white/60 shadow-soft dark:border-white/10 dark:bg-white/5">
              <img class="h-48 w-full object-cover md:h-64" src={cover} alt={`文章封面：${post.data.title}`} loading="eager" data-image-preview />
            </div>
          )}
          <aside class:list={["hidden rounded-[1.35rem] border border-white/70 bg-white/68 p-5 shadow-soft backdrop-blur-xl lg:block dark:border-white/10 dark:bg-white/[0.055]", !cover && "lg:justify-self-end lg:w-[17rem]"]}>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-ink-500 dark:text-ink-300">Article Brief</p>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex items-center justify-between gap-4 border-b border-ink-200/60 pb-3 dark:border-white/10">
                <dt class="inline-flex items-center gap-2 text-ink-500 dark:text-ink-300"><Icon name="calendar" class="h-3.5 w-3.5" />发布</dt>
                <dd class="font-medium text-ink-800 dark:text-ink-100">{formatDate(post.data.pubDate)}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 border-b border-ink-200/60 pb-3 dark:border-white/10">
                <dt class="inline-flex items-center gap-2 text-ink-500 dark:text-ink-300"><Icon name="clock" class="h-3.5 w-3.5" />阅读</dt>
                <dd class="font-medium text-ink-800 dark:text-ink-100">{getReadingTime(post.body)}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 border-b border-ink-200/60 pb-3 dark:border-white/10">
                <dt class="inline-flex items-center gap-2 text-ink-500 dark:text-ink-300"><Icon name="grid" class="h-3.5 w-3.5" />分类</dt>
                <dd class="font-medium text-ink-800 dark:text-ink-100">{post.data.category}</dd>
              </div>
              {post.data.updatedDate && (
                <div class="flex items-center justify-between gap-4">
                  <dt class="text-ink-500 dark:text-ink-300">更新</dt>
                  <dd class="font-medium text-ink-800 dark:text-ink-100">{formatDate(post.data.updatedDate)}</dd>
                </div>
              )}
            </dl>
          </aside>
        </div>
      </header>

      {toc.length > 0 && (
        <details class="mt-6 lg:hidden">
          <summary class="cursor-pointer list-none text-sm font-bold text-ink-800 dark:text-ink-100">
            本页目录
          </summary>
          <nav class="mt-3 space-y-2.5">
            {toc.map((heading) => (
              <a class:list={["block leading-6 text-ink-600 transition hover:text-leaf-700 dark:text-ink-200 dark:hover:text-leaf-300", heading.depth === 3 ? "pl-2 text-xs font-medium" : "font-semibold"]} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}

      <div class="prose-blog mt-8 max-w-none" data-enhance-content>
        <slot />
      </div>

      <section class="mt-12 grid gap-4 border-t border-ink-200/70 pt-8 md:grid-cols-2 dark:border-white/10" data-reveal>
        {prev ? (
          <a class="post-card group relative overflow-hidden rounded-2xl border border-white/70 bg-white/70 p-5 shadow-soft dark:border-white/10 dark:bg-white/5" href={getPostUrl(prev)}>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-500 dark:text-ink-300">上一篇</p>
            <p class="mt-2 text-base font-semibold text-ink-950 transition group-hover:text-leaf-700 dark:text-white dark:group-hover:text-leaf-300">{prev.data.title}</p>
          </a>
        ) : <div></div>}
        {next ? (
          <a class="post-card group relative overflow-hidden rounded-2xl border border-white/70 bg-white/70 p-5 text-right shadow-soft dark:border-white/10 dark:bg-white/5" href={getPostUrl(next)}>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-500 dark:text-ink-300">下一篇</p>
            <p class="mt-2 text-base font-semibold text-ink-950 transition group-hover:text-leaf-700 dark:text-white dark:group-hover:text-leaf-300">{next.data.title}</p>
          </a>
        ) : <div></div>}
      </section>

      {related.length > 0 && (
        <section class="mt-12" data-reveal>
          <div class="mb-5 flex items-center gap-2">
            <Icon name="spark" class="h-4 w-4 text-leaf-600 dark:text-leaf-300" />
            <h2 class="text-xl font-semibold text-ink-950 dark:text-white">相关推荐</h2>
          </div>
          <div class="grid gap-4 md:grid-cols-3">
            {related.map((item) => <PostCard post={item} compact showDate={false} />)}
          </div>
        </section>
      )}
    </div>

  </article>
  <button class="article-back-to-top" type="button" data-back-to-top aria-label="返回文章开头" title="返回文章开头" tabindex="-1" aria-hidden="true">
    <Icon name="arrow-up" class="h-5 w-5" />
  </button>

  <script is:inline data-astro-rerun>
    if (!window.__articleBeforeSwapHandler) {
      window.__articleBeforeSwapHandler = () => window.__cleanupArticleEnhancements?.();
      document.addEventListener("astro:before-swap", window.__articleBeforeSwapHandler);
    }

    function enhanceArticle() {
      window.__cleanupArticleEnhancements?.();
      const progress = document.querySelector("#reading-progress");
      const article = document.querySelector("[data-reading-article]");
      const content = document.querySelector("[data-enhance-content]");
      const backToTop = document.querySelector("[data-back-to-top]");
      const articleTitle = document.querySelector("[data-article-title]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!article || !content) {
        if (progress) progress.style.transform = "scaleX(0)";
        return;
      }

      let articleResizeObserver;
      let tocObserver;
      let tocNav;
      let tocScrollTimer;
      let showTocScrollbar = () => {};

      let articleTop = 0;
      let articleScrollable = 1;
      const measureArticle = () => {
        const rect = article.getBoundingClientRect();
        articleTop = rect.top + window.scrollY;
        articleScrollable = Math.max(article.offsetHeight - window.innerHeight, 1);
      };
      const updateProgress = () => {
        const scrolled = Math.min(Math.max(window.scrollY - articleTop, 0), articleScrollable);
        const ratio = scrolled / articleScrollable;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        if (backToTop) {
          const visible = window.scrollY > 360;
          backToTop.classList.toggle("is-visible", visible);
          backToTop.tabIndex = visible ? 0 : -1;
          backToTop.setAttribute("aria-hidden", String(!visible));
        }
      };
      const measureAndUpdate = () => {
        measureArticle();
        updateProgress();
      };
      measureAndUpdate();
      window.addEventListener("site:scroll", updateProgress);
      window.addEventListener("resize", measureAndUpdate);
      window.addEventListener("load", measureAndUpdate, { once: true });
      if ("ResizeObserver" in window) {
        articleResizeObserver = new ResizeObserver(measureAndUpdate);
        articleResizeObserver.observe(article);
      }
      const returnToArticleStart = (moveFocus) => {
        if (moveFocus) {
          articleTitle?.focus({ preventScroll: true });
        } else {
          backToTop?.blur();
        }
        window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
      };
      backToTop?.addEventListener("click", (event) => {
        returnToArticleStart(event.detail === 0);
      });
      backToTop?.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        returnToArticleStart(true);
      });

      content.querySelectorAll("pre").forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-block")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "code-block";
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code-btn";
        button.textContent = "复制";
        button.addEventListener("click", async () => {
          const text = pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "✓ 已复制";
            button.classList.add("is-success");
            window.setTimeout(() => {
              button.textContent = "复制";
              button.classList.remove("is-success");
            }, 1400);
          } catch {
            button.textContent = "失败";
            window.setTimeout(() => {
              button.textContent = "复制";
            }, 1400);
          }
        });
        wrapper.appendChild(button);
      });

      content.querySelectorAll("h2[id], h3[id]").forEach((heading) => {
        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.className = "heading-anchor";
        link.setAttribute("aria-label", "复制标题链接");
        link.textContent = "#";
        link.addEventListener("click", async (event) => {
          event.preventDefault();
          const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
          history.replaceState(null, "", `#${heading.id}`);
          try {
            await navigator.clipboard.writeText(url);
            link.textContent = "✓";
            link.classList.add("is-copied");
            window.setTimeout(() => {
              link.textContent = "#";
              link.classList.remove("is-copied");
            }, 1200);
          } catch {
            // ignore clipboard errors
          }
        });
        heading.appendChild(link);
      });

      const previewImages = new Set([
        ...content.querySelectorAll("img"),
        ...document.querySelectorAll("img[data-image-preview]"),
      ]);

      previewImages.forEach((img) => {
        img.classList.add("zoomable-image");
        img.tabIndex = 0;
        img.setAttribute("role", "button");
        img.setAttribute("aria-label", `放大查看图片：${img.alt || "图片"}`);

        const openLightbox = () => {
          const returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : img;
          const previousBodyOverflow = document.body.style.overflow;
          const overlay = document.createElement("div");
          overlay.className = "image-lightbox";
          overlay.setAttribute("role", "dialog");
          overlay.setAttribute("aria-modal", "true");
          overlay.setAttribute("aria-label", "图片预览");
          overlay.tabIndex = -1;

          const preview = document.createElement("img");
          preview.src = img.currentSrc || img.src;
          preview.alt = img.alt;

          const closeButton = document.createElement("button");
          closeButton.type = "button";
          closeButton.className = "image-lightbox-close";
          closeButton.setAttribute("aria-label", "关闭图片预览");
          closeButton.title = "关闭图片预览";
          closeButton.textContent = "\u00d7";

          const hint = document.createElement("p");
          hint.className = "image-lightbox-hint";
          hint.id = "image-lightbox-hint";
          hint.textContent = "按 Esc 关闭图片预览";
          overlay.setAttribute("aria-describedby", hint.id);

          const backgroundRegions = Array.from(document.body.children).filter((element) => element !== overlay);
          const previousInertStates = backgroundRegions.map((element) => element.inert);
          let isClosing = false;
          const closeLightbox = () => {
            if (isClosing) return;
            isClosing = true;
            document.body.style.overflow = previousBodyOverflow;
            overlay.classList.add("is-closing");
            const delay = reduceMotion ? 0 : 180;
            window.setTimeout(() => {
              overlay.remove();
              backgroundRegions.forEach((element, index) => {
                element.inert = previousInertStates[index];
              });
              returnFocus.focus();
            }, delay);
          };

          closeButton.addEventListener("click", closeLightbox);
          overlay.addEventListener("click", (event) => {
            if (event.target === overlay) closeLightbox();
          });
          overlay.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeLightbox();
            if (event.key === "Tab") {
              const focusable = Array.from(overlay.querySelectorAll("button:not([disabled]), [href], [tabindex]:not([tabindex='-1'])"));
              const first = focusable[0];
              const last = focusable[focusable.length - 1];
              if (!first || !last) return;
              if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              }
            }
          });
          overlay.append(preview, closeButton, hint);
          document.body.appendChild(overlay);
          backgroundRegions.forEach((element) => {
            element.inert = true;
          });
          document.body.style.overflow = "hidden";
          closeButton.focus();
        };

        img.addEventListener("click", openLightbox);
        img.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          openLightbox();
        });
      });

      const tocLinks = Array.from(document.querySelectorAll("[data-toc-slug]"));
      if (tocLinks.length) {
        tocNav = document.querySelector("[data-toc-nav]");
        let activeTocSlug = "";
        showTocScrollbar = () => {
          tocNav?.classList.add("is-scrolling");
          window.clearTimeout(tocScrollTimer);
          tocScrollTimer = window.setTimeout(() => tocNav?.classList.remove("is-scrolling"), 700);
        };
        tocNav?.addEventListener("scroll", showTocScrollbar, { passive: true });
        const headings = tocLinks
          .map((link) => document.getElementById(link.getAttribute("data-toc-slug") || ""))
          .filter(Boolean);
        const setActiveToc = (slug) => {
          if (!slug || activeTocSlug === slug) return;
          activeTocSlug = slug;
          tocLinks.forEach((link) => {
            link.classList.toggle("is-active", link.getAttribute("data-toc-slug") === slug);
          });
          const activeLink = tocLinks.find((link) => link.getAttribute("data-toc-slug") === slug);
          activeLink?.scrollIntoView({ block: "nearest", inline: "nearest", behavior: reduceMotion ? "auto" : "smooth" });
        };
        tocObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visible?.target?.id) return;
            setActiveToc(visible.target.id);
          },
          { rootMargin: "-20% 0px -65% 0px", threshold: [0.1, 0.5, 1] },
        );
        headings.forEach((heading) => tocObserver.observe(heading));
      }

      window.__cleanupArticleEnhancements = () => {
        window.removeEventListener("site:scroll", updateProgress);
        window.removeEventListener("resize", measureAndUpdate);
        articleResizeObserver?.disconnect();
        tocObserver?.disconnect();
        tocNav?.removeEventListener("scroll", showTocScrollbar);
        window.clearTimeout(tocScrollTimer);
        tocNav?.classList.remove("is-scrolling");
        if (progress) progress.style.transform = "scaleX(0)";
      };
    }

    if (!window.__articlePageLoadHandler) {
      window.__articlePageLoadHandler = () => enhanceArticle();
      document.addEventListener("astro:page-load", window.__articlePageLoadHandler);
    }
    enhanceArticle();
  </script>
</BaseLayout>
