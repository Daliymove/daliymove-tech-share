---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import {
  formatDate,
  absoluteUrl,
  getAdjacentPosts,
  getAllPosts,
  getCategoryUrl,
  getCoverUrl,
  getOgImageAbsoluteUrl,
  getOgImageUrl,
  getPostAbsoluteUrl,
  getPostUrl,
  getReadingTime,
  getRelatedPosts,
  getTagUrl,
  withBase,
  type BlogPost,
} from "../lib/posts";
import { site } from "../lib/site";

interface Props {
  post: BlogPost;
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { post, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const posts = await getAllPosts();
const { prev, next } = getAdjacentPosts(posts, post);
const related = getRelatedPosts(posts, post, 3);
const cover = getCoverUrl(post);
const ogImage = getOgImageUrl(post);
const articleUrl = getPostAbsoluteUrl(post);
const breadcrumbStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "文章", item: absoluteUrl("/blog/") },
    { "@type": "ListItem", position: 3, name: post.data.title, item: articleUrl },
  ],
}).replace(/</g, "\\u003c");
const articleStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: articleUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  inLanguage: "zh-CN",
  articleSection: post.data.category,
  ...(post.data.tags.length ? { keywords: post.data.tags.join(", ") } : {}),
  image: {
    "@type": "ImageObject",
    url: getOgImageAbsoluteUrl(post),
    caption: post.data.title,
  },
  author: {
    "@type": "Person",
    name: site.author,
    url: site.github,
    sameAs: [site.github],
  },
  isPartOf: {
    "@type": "Blog",
    name: site.title,
    url: site.url,
  },
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  imageAlt={`文章分享图：${post.data.title}`}
  type="article"
  articlePublishedTime={post.data.pubDate.toISOString()}
  articleModifiedTime={post.data.updatedDate?.toISOString()}
  articleSection={post.data.category}
  articleTags={post.data.tags}
  canonicalPath={`/blog/${post.id.replace(/\.(md|mdx)$/i, "").replace(/\/index$/, "")}/`}
>
  <script is:inline type="application/ld+json" set:html={articleStructuredData}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbStructuredData}></script>
  <article class="mx-auto max-w-3xl min-w-0" data-pagefind-body data-reading-article>
    <!-- 返回导航与类别 -->
    <div class="flex items-center justify-between gap-4 text-xs">
      <a class="inline-flex items-center gap-1.5 font-medium text-ink-500 transition hover:text-leaf-700 dark:text-ink-400 dark:hover:text-leaf-300" href={withBase("/blog/")}>
        <span aria-hidden="true">←</span>
        返回文章列表
      </a>
      <div class="flex items-center gap-2">
        <a class="inline-flex items-center gap-1 rounded-full border border-leaf-200/80 bg-leaf-50/80 px-2.5 py-0.5 font-semibold text-leaf-700 dark:border-leaf-300/20 dark:bg-leaf-300/10 dark:text-leaf-100" href={getCategoryUrl(post.data.category)}>
          <Icon name="grid" class="h-3 w-3" />
          {post.data.category}
        </a>
        {post.data.series && (
          <span class="inline-flex items-center gap-1 rounded-full border border-bark-300/40 bg-bark-100/80 px-2.5 py-0.5 font-semibold text-bark-700 dark:border-bark-300/25 dark:bg-bark-500/15 dark:text-bark-300">
            <Icon name="layers" class="h-3 w-3" />
            系列 · {post.data.series}
          </span>
        )}
        {post.data.pinned && (
          <span class="inline-flex items-center gap-1 rounded-full border border-amber-300/70 bg-amber-50/80 px-2.5 py-0.5 font-semibold text-amber-700 dark:border-amber-300/25 dark:bg-amber-300/10 dark:text-amber-100">
            <Icon name="pin" class="h-3 w-3" />
            置顶
          </span>
        )}
      </div>
    </div>

    <!-- 文章主标题区 -->
    <header class="mt-8 border-b border-ink-200/60 pb-7 dark:border-white/10" data-reveal>
      <h1 class="font-display text-2xl font-extrabold leading-snug tracking-normal text-ink-950 sm:text-3xl md:text-4xl dark:text-white" data-pagefind-meta="title" data-article-title tabindex="-1">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="mt-4 text-base leading-7 text-ink-600 dark:text-ink-300">
          {post.data.description}
        </p>
      )}

      <!-- 极简整合元信息 -->
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-500 dark:text-ink-400">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="calendar" class="h-3.5 w-3.5 opacity-75" />
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </span>
        <span class="text-ink-300 dark:text-ink-600">·</span>
        <span class="inline-flex items-center gap-1.5">
          <Icon name="clock" class="h-3.5 w-3.5 opacity-75" />
          <span>{getReadingTime(post.body)}</span>
        </span>
        {post.data.updatedDate && (
          <>
            <span class="text-ink-300 dark:text-ink-600">·</span>
            <span>更新于 {formatDate(post.data.updatedDate)}</span>
          </>
        )}
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5 sm:ml-auto">
            {post.data.tags.map((tag) => (
              <a class="rounded-full bg-ink-100/70 px-2 py-0.5 text-[11px] font-medium text-ink-600 transition hover:bg-leaf-100 hover:text-leaf-700 dark:bg-white/10 dark:text-ink-300 dark:hover:bg-leaf-300/10 dark:hover:text-leaf-200" href={getTagUrl(tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- 封面图（若存在，极简圆角展示） -->
      {cover && (
        <div class="mt-6 overflow-hidden rounded-2xl border border-ink-200/50 bg-ink-50/30 shadow-soft dark:border-white/10 dark:bg-white/5">
          <img class="block max-h-[380px] w-full object-cover" src={cover} alt={`文章封面：${post.data.title}`} loading="eager" data-image-preview />
        </div>
      )}

      <!-- 首屏轻量折叠式目录 -->
      {toc.length > 0 && (
        <details class="group mt-6 rounded-xl border border-ink-200/60 bg-ink-50/40 p-4 transition open:pb-4 dark:border-white/10 dark:bg-white/[0.03]">
          <summary class="flex cursor-pointer list-none items-center justify-between text-xs font-bold uppercase tracking-wider text-ink-700 dark:text-ink-200">
            <span class="inline-flex items-center gap-2">
              <Icon name="layers" class="h-3.5 w-3.5 text-leaf-600 dark:text-leaf-300" />
              文章目录 ({toc.length})
            </span>
            <span class="text-xs text-ink-400 transition-transform duration-200 group-open:rotate-180 dark:text-ink-500">▼</span>
          </summary>
          <nav class="mt-3.5 space-y-2 border-t border-ink-200/50 pt-3 text-sm" data-toc-nav>
            {toc.map((heading) => (
              <a
                class:list={[
                  "toc-link block leading-relaxed text-ink-600 transition hover:text-leaf-700 dark:text-ink-300 dark:hover:text-leaf-300",
                  heading.depth === 3 ? "pl-3 text-xs opacity-90" : "font-medium"
                ]}
                href={`#${heading.slug}`}
                data-toc-slug={heading.slug}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      )}
    </header>

    <!-- 文章主体正文 -->
    <div class="prose-blog mt-9 max-w-none" data-enhance-content>
      <slot />
    </div>

    <!-- 上下篇翻页 -->
    <nav class="mt-14 flex flex-col items-stretch justify-between gap-4 border-t border-ink-200/60 pt-8 sm:flex-row dark:border-white/10" aria-label="文章翻页" data-reveal>
      {prev ? (
        <a class="group flex flex-1 flex-col items-start rounded-xl border border-ink-200/60 bg-white/40 p-4 transition hover:border-leaf-500/40 hover:bg-white/80 dark:border-white/10 dark:bg-white/5 dark:hover:border-leaf-300/40" href={getPostUrl(prev)}>
          <span class="inline-flex items-center gap-1 text-xs font-medium text-ink-400 transition group-hover:text-leaf-600 dark:text-ink-400 dark:group-hover:text-leaf-300">
            ← 上一篇
          </span>
          <span class="mt-1 text-sm font-semibold text-ink-900 transition group-hover:text-leaf-700 dark:text-ink-100 dark:group-hover:text-leaf-200 line-clamp-2">
            {prev.data.title}
          </span>
        </a>
      ) : <div class="flex-1"></div>}
      {next ? (
        <a class="group flex flex-1 flex-col items-end rounded-xl border border-ink-200/60 bg-white/40 p-4 text-right transition hover:border-leaf-500/40 hover:bg-white/80 dark:border-white/10 dark:bg-white/5 dark:hover:border-leaf-300/40" href={getPostUrl(next)}>
          <span class="inline-flex items-center gap-1 text-xs font-medium text-ink-400 transition group-hover:text-leaf-600 dark:text-ink-400 dark:group-hover:text-leaf-300">
            下一篇 →
          </span>
          <span class="mt-1 text-sm font-semibold text-ink-900 transition group-hover:text-leaf-700 dark:text-ink-100 dark:group-hover:text-leaf-200 line-clamp-2">
            {next.data.title}
          </span>
        </a>
      ) : <div class="flex-1"></div>}
    </nav>

    <!-- 相关推荐 -->
    {related.length > 0 && (
      <section class="mt-12 border-t border-ink-200/60 pt-8 dark:border-white/10" data-reveal>
        <div class="mb-5 flex items-center gap-2">
          <Icon name="spark" class="h-4 w-4 text-leaf-600 dark:text-leaf-300" />
          <h2 class="text-lg font-semibold text-ink-950 dark:text-white">相关推荐</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {related.map((item) => <PostCard post={item} compact showDate={false} />)}
        </div>
      </section>
    )}
  </article>

  <!-- 浮动操作组（右下角） -->
  <aside class="article-floating-actions" aria-label="文章快速操作">
    {toc.length > 0 && (
      <button
        class="article-action-btn article-toc-toggle"
        type="button"
        data-toc-toggle
        aria-label="打开文章目录"
        title="文章目录"
        aria-expanded="false"
      >
        <Icon name="layers" class="h-4 w-4" />
      </button>
    )}
    <button
      class="article-action-btn article-back-to-top"
      type="button"
      data-back-to-top
      aria-label="返回文章开头"
      title="返回文章开头"
      tabindex="-1"
      aria-hidden="true"
    >
      <Icon name="arrow-up" class="h-4 w-4" />
    </button>
  </aside>

  <!-- 悬浮目录抽屉/面板 -->
  {toc.length > 0 && (
    <div class="floating-toc-backdrop" data-toc-backdrop aria-hidden="true">
      <div class="floating-toc-panel" role="dialog" aria-modal="true" aria-label="文章目录导航" data-toc-panel>
        <div class="flex items-center justify-between border-b border-ink-200/60 pb-3 dark:border-white/10">
          <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-ink-800 dark:text-ink-100">
            <Icon name="layers" class="h-3.5 w-3.5 text-leaf-600 dark:text-leaf-300" />
            目录导航
          </p>
          <button class="floating-toc-close text-ink-400 hover:text-ink-900 dark:text-ink-400 dark:hover:text-white text-base leading-none px-1" type="button" data-toc-close aria-label="关闭目录">
            ✕
          </button>
        </div>
        <nav class="mt-3 max-h-[60vh] space-y-2 overflow-y-auto pr-1 text-sm" data-floating-toc-nav>
          {toc.map((heading) => (
            <a
              class:list={[
                "toc-link block leading-relaxed text-ink-600 transition hover:text-leaf-700 dark:text-ink-300 dark:hover:text-leaf-300",
                heading.depth === 3 ? "pl-3 text-xs opacity-90" : "font-medium"
              ]}
              href={`#${heading.slug}`}
              data-toc-slug={heading.slug}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </div>
    </div>
  )}

  <script is:inline data-astro-rerun>
    if (!window.__articleBeforeSwapHandler) {
      window.__articleBeforeSwapHandler = () => window.__cleanupArticleEnhancements?.();
      document.addEventListener("astro:before-swap", window.__articleBeforeSwapHandler);
    }

    function enhanceArticle() {
      const progress = document.querySelector("#reading-progress");
      const article = document.querySelector("[data-reading-article]");
      const content = document.querySelector("[data-enhance-content]");
      const backToTop = document.querySelector("[data-back-to-top]");
      const articleTitle = document.querySelector("[data-article-title]");
      const tocToggle = document.querySelector("[data-toc-toggle]");
      const tocBackdrop = document.querySelector("[data-toc-backdrop]");
      const tocClose = document.querySelector("[data-toc-close]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!article || !content) {
        if (progress) progress.style.transform = "scaleX(0)";
        return;
      }

      if (content.getAttribute("data-article-enhanced") === "true") return;
      window.__cleanupArticleEnhancements?.();
      content.setAttribute("data-article-enhanced", "true");

      let articleResizeObserver;
      let tocObserver;
      let articleTop = 0;
      let articleScrollable = 1;

      const measureArticle = () => {
        const rect = article.getBoundingClientRect();
        articleTop = rect.top + window.scrollY;
        articleScrollable = Math.max(article.offsetHeight - window.innerHeight, 1);
      };

      const updateProgress = () => {
        const scrolled = Math.min(Math.max(window.scrollY - articleTop, 0), articleScrollable);
        const ratio = scrolled / articleScrollable;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        if (backToTop) {
          const visible = window.scrollY > 360;
          backToTop.classList.toggle("is-visible", visible);
          backToTop.tabIndex = visible ? 0 : -1;
          backToTop.setAttribute("aria-hidden", String(!visible));
        }
      };

      const measureAndUpdate = () => {
        measureArticle();
        updateProgress();
      };

      measureAndUpdate();
      window.addEventListener("site:scroll", updateProgress);
      window.addEventListener("resize", measureAndUpdate);
      window.addEventListener("load", measureAndUpdate, { once: true });

      if ("ResizeObserver" in window) {
        articleResizeObserver = new ResizeObserver(measureAndUpdate);
        articleResizeObserver.observe(article);
      }

      const returnToArticleStart = (moveFocus) => {
        if (moveFocus) {
          articleTitle?.focus({ preventScroll: true });
        } else {
          backToTop?.blur();
        }
        window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
      };

      backToTop?.addEventListener("click", (event) => {
        returnToArticleStart(event.detail === 0);
      });
      backToTop?.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        returnToArticleStart(true);
      });

      // 悬浮目录面板逻辑
      const openTocPanel = () => {
        if (!tocBackdrop) return;
        tocBackdrop.classList.add("is-open");
        tocBackdrop.setAttribute("aria-hidden", "false");
        tocToggle?.setAttribute("aria-expanded", "true");
      };

      const closeTocPanel = () => {
        if (!tocBackdrop) return;
        tocBackdrop.classList.remove("is-open");
        tocBackdrop.setAttribute("aria-hidden", "true");
        tocToggle?.setAttribute("aria-expanded", "false");
      };

      tocToggle?.addEventListener("click", () => {
        if (tocBackdrop?.classList.contains("is-open")) {
          closeTocPanel();
        } else {
          openTocPanel();
        }
      });

      tocClose?.addEventListener("click", closeTocPanel);
      tocBackdrop?.addEventListener("click", (e) => {
        if (e.target === tocBackdrop) closeTocPanel();
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && tocBackdrop?.classList.contains("is-open")) {
          closeTocPanel();
        }
      });

      // 代码块增强（复制按钮）
      content.querySelectorAll("pre").forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-block")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "code-block";
        wrapper.setAttribute("data-article-generated", "true");
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code-btn";
        button.textContent = "复制";
        button.addEventListener("click", async () => {
          const text = pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "✓ 已复制";
            button.classList.add("is-success");
            window.setTimeout(() => {
              button.textContent = "复制";
              button.classList.remove("is-success");
            }, 1400);
          } catch {
            button.textContent = "失败";
            window.setTimeout(() => {
              button.textContent = "复制";
            }, 1400);
          }
        });
        wrapper.appendChild(button);
      });

      // 标题链接锚点
      content.querySelectorAll("h2[id], h3[id]").forEach((heading) => {
        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.className = "heading-anchor";
        link.setAttribute("data-article-generated-anchor", "true");
        link.setAttribute("aria-label", "复制标题链接");
        link.textContent = "#";
        link.addEventListener("click", async (event) => {
          event.preventDefault();
          const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
          history.replaceState(null, "", `#${heading.id}`);
          try {
            await navigator.clipboard.writeText(url);
            link.textContent = "✓";
            link.classList.add("is-copied");
            window.setTimeout(() => {
              link.textContent = "#";
              link.classList.remove("is-copied");
            }, 1200);
          } catch {
            // ignore clipboard errors
          }
        });
        heading.appendChild(link);
      });

      // 图片灯箱
      let disposeLightbox = () => {};
      const previewImages = new Set([
        ...content.querySelectorAll("img"),
        ...document.querySelectorAll("img[data-image-preview]"),
      ]);

      previewImages.forEach((img) => {
        img.classList.add("zoomable-image");
        img.tabIndex = 0;
        img.setAttribute("role", "button");
        img.setAttribute("aria-label", `放大查看图片：${img.alt || "图片"}`);

        const openLightbox = () => {
          disposeLightbox();
          const returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : img;
          const previousBodyOverflow = document.body.style.overflow;
          const overlay = document.createElement("div");
          overlay.className = "image-lightbox";
          overlay.setAttribute("data-article-lightbox", "true");
          overlay.setAttribute("role", "dialog");
          overlay.setAttribute("aria-modal", "true");
          overlay.setAttribute("aria-label", "图片预览");
          overlay.tabIndex = -1;

          const preview = document.createElement("img");
          preview.src = img.currentSrc || img.src;
          preview.alt = img.alt;

          const closeButton = document.createElement("button");
          closeButton.type = "button";
          closeButton.className = "image-lightbox-close";
          closeButton.setAttribute("aria-label", "关闭图片预览");
          closeButton.title = "关闭图片预览";
          closeButton.textContent = "\u00d7";

          const hint = document.createElement("p");
          hint.className = "image-lightbox-hint";
          hint.id = "image-lightbox-hint";
          hint.textContent = "按 Esc 关闭图片预览";
          overlay.setAttribute("aria-describedby", hint.id);

          const backgroundRegions = Array.from(document.body.children).filter((element) => element !== overlay);
          const previousInertStates = backgroundRegions.map((element) => element.inert);
          let isClosing = false;
          const restoreLightbox = () => {
            document.body.style.overflow = previousBodyOverflow;
            overlay.remove();
            backgroundRegions.forEach((element, index) => {
              element.inert = previousInertStates[index];
            });
            if (disposeLightbox === restoreLightbox) disposeLightbox = () => {};
          };
          disposeLightbox = restoreLightbox;
          const closeLightbox = () => {
            if (isClosing) return;
            isClosing = true;
            overlay.classList.add("is-closing");
            const delay = reduceMotion ? 0 : 180;
            window.setTimeout(() => {
              restoreLightbox();
              if (returnFocus.isConnected) returnFocus.focus();
            }, delay);
          };

          closeButton.addEventListener("click", closeLightbox);
          overlay.addEventListener("click", (event) => {
            if (event.target === overlay) closeLightbox();
          });
          overlay.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeLightbox();
            if (event.key === "Tab") {
              const focusable = Array.from(overlay.querySelectorAll("button:not([disabled]), [href], [tabindex]:not([tabindex='-1'])"));
              const first = focusable[0];
              const last = focusable[focusable.length - 1];
              if (!first || !last) return;
              if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              }
            }
          });
          overlay.append(preview, closeButton, hint);
          document.body.appendChild(overlay);
          backgroundRegions.forEach((element) => {
            element.inert = true;
          });
          document.body.style.overflow = "hidden";
          closeButton.focus();
        };

        img.addEventListener("click", openLightbox);
        img.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          openLightbox();
        });
      });

      // 目录高亮同步
      const tocLinks = Array.from(document.querySelectorAll("[data-toc-slug]"));
      if (tocLinks.length) {
        let activeTocSlug = "";
        const headings = tocLinks
          .map((link) => document.getElementById(link.getAttribute("data-toc-slug") || ""))
          .filter(Boolean);

        const setActiveToc = (slug) => {
          if (!slug || activeTocSlug === slug) return;
          activeTocSlug = slug;
          tocLinks.forEach((link) => {
            link.classList.toggle("is-active", link.getAttribute("data-toc-slug") === slug);
          });
        };

        tocObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visible?.target?.id) return;
            setActiveToc(visible.target.id);
          },
          { rootMargin: "-20% 0px -65% 0px", threshold: [0.1, 0.5, 1] },
        );
        headings.forEach((heading) => tocObserver.observe(heading));

        // 点击悬浮目录链接时自动关闭面板
        document.querySelectorAll("[data-floating-toc-nav] a").forEach((a) => {
          a.addEventListener("click", () => {
            closeTocPanel();
          });
        });
      }

      window.__cleanupArticleEnhancements = () => {
        window.removeEventListener("site:scroll", updateProgress);
        window.removeEventListener("resize", measureAndUpdate);
        articleResizeObserver?.disconnect();
        tocObserver?.disconnect();
        disposeLightbox();
        content.querySelectorAll("[data-article-generated-anchor]").forEach((link) => link.remove());
        content.querySelectorAll(".code-block[data-article-generated]").forEach((wrapper) => {
          const pre = wrapper.querySelector("pre");
          if (pre) wrapper.parentNode?.insertBefore(pre, wrapper);
          wrapper.remove();
        });
        document.querySelectorAll("[data-article-lightbox]").forEach((overlay) => overlay.remove());
        content.removeAttribute("data-article-enhanced");
        if (progress) progress.style.transform = "scaleX(0)";
      };
    }

    if (!window.__articlePageLoadHandler) {
      window.__articlePageLoadHandler = () => enhanceArticle();
      document.addEventListener("astro:page-load", window.__articlePageLoadHandler);
    }
    enhanceArticle();
  </script>
</BaseLayout>
