---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import { absoluteUrl, defaultImageHeight, defaultImagePath, defaultImageWidth, withBase } from "../lib/posts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  canonicalPath?: string;
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title,
  description = site.description,
  image = withBase(defaultImagePath),
  imageAlt,
  imageWidth,
  imageHeight,
  type = "website",
  canonicalPath,
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  articleTags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const currentPath = Astro.url.pathname;
const homeHref = withBase("/");
const searchHref = withBase("/search/");
const faviconSvgHref = withBase("/favicon.svg");
const faviconPngHref = withBase("/favicon.png");
const logoHref = withBase("/images/logo-marks/folded-path.svg");
const rssHref = withBase("/rss.xml");
const routePath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/") || "/";
const canonical = absoluteUrl(canonicalPath ?? routePath);
const ogPath = image.replace(import.meta.env.BASE_URL, "/") || defaultImagePath;
const ogImage = image.startsWith("http") ? image : absoluteUrl(ogPath);
const ogImageAlt = imageAlt ?? `${title ?? site.title} 的分享图`;
const usesDefaultImage = image === withBase(defaultImagePath);
const ogImageWidth = imageWidth ?? (usesDefaultImage ? defaultImageWidth : undefined);
const ogImageHeight = imageHeight ?? (usesDefaultImage ? defaultImageHeight : undefined);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F5F6F3" data-theme-color />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconSvgHref} />
    <link rel="alternate icon" type="image/png" sizes="144x144" href={faviconPngHref} />
    <link rel="apple-touch-icon" sizes="144x144" href={faviconPngHref} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={rssHref} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {type === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {type === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {type === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {type === "article" && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{pageTitle}</title>
    <script is:inline>
      const themeRoot = document.documentElement;
      const motionPreferenceReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      themeRoot.classList.toggle("motion-ready", !motionPreferenceReduced);
      let savedTheme = null;
      try {
        savedTheme = localStorage.getItem("theme");
      } catch {}
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDarkTheme = savedTheme ? savedTheme === "dark" : prefersDark;
      themeRoot.classList.toggle("dark", isDarkTheme);
      themeRoot.dataset.theme = isDarkTheme ? "dark" : "light";
      themeRoot.style.colorScheme = isDarkTheme ? "dark" : "light";
      document.querySelector("meta[data-theme-color]")?.setAttribute("content", isDarkTheme ? "#101010" : "#F5F6F3");
    </script>
  </head>
  <body>
    <div class="theme-transition-overlay" aria-hidden="true"></div>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header sticky top-0 z-40 px-3 pt-3 md:px-5">
      <div class="header-shell mx-auto max-w-7xl rounded-2xl border border-white/70 bg-white/75 px-4 py-3 shadow-soft backdrop-blur-2xl transition-all dark:border-white/10 dark:bg-ink-950/70">
        <div class="flex items-center justify-between gap-4">
          <a class="flex min-w-0 items-center gap-3" href={homeHref} aria-label={`${site.title} 首页`}>
            <span class="brand-mark h-11 w-11 shrink-0 rounded-xl" aria-hidden="true">
              <img src={logoHref} alt="" />
            </span>
            <span class="hidden min-[420px]:block">
              <span class="block text-sm font-semibold tracking-wide text-ink-950 dark:text-ink-50">{site.title}</span>
              <span class="block text-xs text-ink-500 dark:text-ink-300">{site.tagline}</span>
            </span>
          </a>
          <nav class="hidden items-center gap-1 rounded-full border border-ink-200/70 bg-white/65 p-1 lg:flex dark:border-white/10 dark:bg-white/5" aria-label="主导航">
            {site.nav.map((item) => {
              const href = withBase(item.href);
              const active = currentPath === href || (item.href !== "/" && currentPath.startsWith(href));
              return (
                <a class:list={["inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm transition", active ? "bg-ink-950 text-white shadow-soft dark:bg-leaf-300 dark:text-ink-950" : "text-ink-600 hover:bg-ink-100 hover:text-ink-950 dark:text-ink-200 dark:hover:bg-white/10 dark:hover:text-white"]} href={href} aria-current={active ? "page" : undefined}>
                  <Icon name={item.icon} class="h-3.5 w-3.5 opacity-80" />
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
          <div class="flex items-center gap-2">
            <a class="utility-icon-button" href={rssHref} aria-label="RSS 订阅" title="RSS 订阅">
              <Icon name="rss" class="h-4 w-4" />
            </a>
            <button class="utility-icon-button theme-toggle" type="button" aria-label="切换至深色模式" aria-pressed="false" title="切换至深色模式">
              <span class="theme-icon-light" aria-hidden="true"><Icon name="sun" class="h-4 w-4" /></span>
              <span class="theme-icon-dark hidden" aria-hidden="true"><Icon name="moon" class="h-4 w-4" /></span>
            </button>
          </div>
        </div>
        <nav class="mt-3 flex gap-1 overflow-x-auto border-t border-ink-200/70 pt-3 lg:hidden dark:border-white/10" aria-label="移动端导航">
          {site.nav.map((item) => {
            const href = withBase(item.href);
            const active = currentPath === href || (item.href !== "/" && currentPath.startsWith(href));
            return (
              <a class:list={["inline-flex shrink-0 items-center gap-1 rounded-full px-3 py-1.5 text-xs transition", active ? "bg-ink-950 text-white dark:bg-leaf-300 dark:text-ink-950" : "text-ink-600 hover:bg-ink-100 dark:text-ink-200 dark:hover:bg-white/10"]} href={href} aria-current={active ? "page" : undefined}>
                <Icon name={item.icon} class="h-3.5 w-3.5 opacity-80" />
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </header>
    <main id="content" tabindex="-1" class="mx-auto min-h-[calc(100vh-13rem)] max-w-7xl px-5 py-10 md:py-14"><slot /></main>
    <footer class="px-5 pb-8 text-sm text-ink-500 dark:text-ink-300">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 rounded-2xl border border-white/60 bg-white/50 px-5 py-5 shadow-soft md:flex-row md:items-center md:justify-between dark:border-white/10 dark:bg-white/5">
        <div>
          <p class="font-medium text-ink-700 dark:text-ink-100">© {new Date().getFullYear()} {site.title}</p>
          <p class="mt-1">{site.tagline}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-ink-500 dark:text-ink-300">
          <a class="hover:text-leaf-700 dark:hover:text-leaf-300" href={rssHref}>RSS</a>
          <span>·</span>
          <a class="hover:text-leaf-700 dark:hover:text-leaf-300" href={searchHref}>搜索</a>
          <span>·</span>
          <span>Powered by Astro · Tailwind · Pagefind</span>
        </div>
      </div>
    </footer>
    <script is:inline define:vars={{ searchHref }}>
      const root = document.documentElement;
      const button = document.querySelector(".theme-toggle");
      const lightIcon = document.querySelector(".theme-icon-light");
      const darkIcon = document.querySelector(".theme-icon-dark");
      const header = document.querySelector(".site-header");
      const themeColor = document.querySelector("meta[data-theme-color]");
      const themeOverlay = document.querySelector(".theme-transition-overlay");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const themeTransitionDuration = 900;

      function applyTheme(isDark) {
        root.classList.toggle("dark", isDark);
        root.dataset.theme = isDark ? "dark" : "light";
        root.style.colorScheme = isDark ? "dark" : "light";
        themeColor?.setAttribute("content", isDark ? "#101010" : "#F5F6F3");
      }

      function syncIcon() {
        const isDark = root.classList.contains("dark");
        lightIcon?.classList.toggle("hidden", isDark);
        darkIcon?.classList.toggle("hidden", !isDark);
        button?.setAttribute("aria-pressed", String(isDark));
        const label = isDark ? "切换至浅色模式" : "切换至深色模式";
        button?.setAttribute("aria-label", label);
        button?.setAttribute("title", label);
      }

      button?.addEventListener("click", () => {
        const next = !root.classList.contains("dark");
        const currentThemeColor = next ? "#101010" : "#f5f6f3";
        button.classList.remove("is-switching");
        void button.offsetWidth;
        button.classList.add("is-switching");
        root.classList.remove("is-theme-transitioning");
        if (!reduceMotion) {
          themeOverlay?.style.setProperty("--theme-transition-color", currentThemeColor);
          void themeOverlay?.getBoundingClientRect();
          root.classList.add("is-theme-transitioning");
        }
        window.setTimeout(() => applyTheme(next), reduceMotion ? 0 : themeTransitionDuration * 0.5);
        try {
          localStorage.setItem("theme", next ? "dark" : "light");
        } catch {}
        window.setTimeout(() => {
          syncIcon();
          root.classList.remove("is-theme-transitioning");
        }, reduceMotion ? 0 : themeTransitionDuration);
        window.setTimeout(() => button.classList.remove("is-switching"), 420);
      });
      syncIcon();

      window.addEventListener("pageshow", () => root.classList.remove("is-page-leaving"));

      const revealElements = Array.from(document.querySelectorAll("[data-reveal]"));
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => element.classList.add("is-revealed"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.01 },
        );
        revealElements.forEach((element) => revealObserver.observe(element));
      }

      document.addEventListener("click", (event) => {
        if (reduceMotion || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const source = event.target;
        if (!(source instanceof Element)) return;
        const link = source.closest("a[href]");
        if (!(link instanceof HTMLAnchorElement)) return;
        const href = link.getAttribute("href");
        if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:") || link.hasAttribute("download") || link.target === "_blank") return;
        const target = new URL(link.href, window.location.href);
        const isCurrentDocument = target.origin === window.location.origin
          && target.pathname === window.location.pathname
          && target.search === window.location.search;
        if (target.origin !== window.location.origin || isCurrentDocument) return;
        event.preventDefault();
        root.classList.add("is-page-leaving");
        window.setTimeout(() => {
          window.location.href = target.href;
        }, 90);
      });

      let scrollFrame = 0;
      const updateHeader = () => {
        scrollFrame = 0;
        header?.classList.toggle("is-compact", window.scrollY > 12);
        window.dispatchEvent(new Event("site:scroll"));
      };
      const onScroll = () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(updateHeader);
      };
      updateHeader();
      window.addEventListener("scroll", onScroll, { passive: true });

      window.addEventListener("keydown", (event) => {
        const key = event.key.toLowerCase();
        const isShortcut = (event.metaKey || event.ctrlKey) && key === "k";
        if (!isShortcut) return;
        const target = event.target;
        const tag = target instanceof HTMLElement ? target.tagName : "";
        if (tag === "INPUT" || tag === "TEXTAREA" || (target instanceof HTMLElement && target.isContentEditable)) {
          if (!window.location.pathname.includes("/search")) return;
        }
        event.preventDefault();
        if (window.location.pathname.includes("/search")) {
          document.querySelector("#search-input")?.focus();
          return;
        }
        window.location.href = searchHref;
      });
    </script>
  </body>
</html>
