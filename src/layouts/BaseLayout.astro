---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import { absoluteUrl, defaultImageHeight, defaultImagePath, defaultImageWidth, withBase } from "../lib/posts";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  canonicalPath?: string;
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title,
  description = site.description,
  image = withBase(defaultImagePath),
  imageAlt,
  imageWidth,
  imageHeight,
  type = "website",
  canonicalPath,
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  articleTags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const currentPath = Astro.url.pathname;
const homeHref = withBase("/");
const searchHref = withBase("/search/");
const faviconSvgHref = withBase("/favicon.svg");
const faviconPngHref = withBase("/favicon.png");
const logoHref = withBase("/images/logo-marks/signal-page.svg");
const logoDarkHref = withBase("/images/logo-marks/signal-page-dark.svg");
const rssHref = withBase("/rss.xml");
const routePath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/") || "/";
const canonical = absoluteUrl(canonicalPath ?? routePath);
const ogPath = image.replace(import.meta.env.BASE_URL, "/") || defaultImagePath;
const ogImage = image.startsWith("http") ? image : absoluteUrl(ogPath);
const ogImageAlt = imageAlt ?? `${title ?? site.title} 的分享图`;
const usesDefaultImage = image === withBase(defaultImagePath);
const ogImageWidth = imageWidth ?? (usesDefaultImage ? defaultImageWidth : undefined);
const ogImageHeight = imageHeight ?? (usesDefaultImage ? defaultImageHeight : undefined);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAFAFA" data-theme-color />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconSvgHref} />
    <link rel="alternate icon" type="image/png" sizes="144x144" href={faviconPngHref} />
    <link rel="apple-touch-icon" sizes="144x144" href={faviconPngHref} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={rssHref} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {type === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {type === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {type === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {type === "article" && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <ClientRouter />
    <title>{pageTitle}</title>
    <script is:inline>
      const themeRoot = document.documentElement;
      let savedTheme = null;
      try {
        savedTheme = localStorage.getItem("theme");
      } catch {}
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const runtimeTheme = window.__siteTheme;
      const isDarkTheme = runtimeTheme ? runtimeTheme === "dark" : savedTheme ? savedTheme === "dark" : prefersDark;
      window.__siteTheme = isDarkTheme ? "dark" : "light";
      themeRoot.classList.toggle("dark", isDarkTheme);
      themeRoot.dataset.theme = isDarkTheme ? "dark" : "light";
      themeRoot.style.colorScheme = isDarkTheme ? "dark" : "light";
      document.querySelector("meta[data-theme-color]")?.setAttribute("content", isDarkTheme ? "#0A0A0A" : "#FAFAFA");
    </script>
  </head>
  <body>
    <div id="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#content">跳到正文</a>

    <header class="site-header">
      <div class="qs-container header-inner">
        <a class="brand" href={homeHref} aria-label={`${site.title} 首页`}>
          <span class="brand-mark" aria-hidden="true">
            <img class="brand-mark-light" src={logoHref} alt="" />
            <img class="brand-mark-dark" src={logoDarkHref} alt="" />
          </span>
          <span class="brand-name">{site.title}</span>
          <span class="brand-tagline">{site.tagline}</span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          {site.nav.map((item) => {
            const href = withBase(item.href);
            const active = currentPath === href || (item.href !== "/" && currentPath.startsWith(href));
            return (
              <a class="nav-link" href={href} aria-current={active ? "page" : undefined}>{item.label}</a>
            );
          })}
        </nav>

        <div class="header-actions">
          <a class="icon-btn" href={searchHref} aria-label="搜索文章" title="搜索文章">
            <Icon name="search" class="h-4 w-4" />
          </a>
          <a class="icon-btn" href={rssHref} aria-label="RSS 订阅" title="RSS 订阅">
            <Icon name="rss" class="h-4 w-4" />
          </a>
          <button class="icon-btn theme-toggle" type="button" aria-label="切换至深色模式" aria-pressed="false" title="切换主题" data-theme-toggle>
            <span class="dark:hidden"><Icon name="sun" class="h-4 w-4" /></span>
            <span class="hidden dark:inline"><Icon name="moon" class="h-4 w-4" /></span>
          </button>
          <button class="icon-btn menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-nav" title="菜单" data-menu-toggle>
            <Icon name="menu" class="h-4 w-4" />
          </button>
        </div>
      </div>

      <div id="mobile-nav" class="qs-container mobile-nav" data-mobile-nav>
        <nav aria-label="移动端导航">
          {site.nav.map((item) => {
            const href = withBase(item.href);
            const active = currentPath === href || (item.href !== "/" && currentPath.startsWith(href));
            return <a class="mobile-nav-link" href={href} aria-current={active ? "page" : undefined}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1" class="qs-container min-h-[calc(100vh-14rem)] py-12 md:py-16"><slot /></main>

    <footer class="site-footer">
      <div class="qs-container footer-inner">
        <p class="m-0">© {new Date().getFullYear()} {site.title} · {site.tagline}</p>
        <p class="m-0 flex flex-wrap items-center gap-3">
          <a class="qs-plain-link" href={rssHref}>RSS</a>
          <span aria-hidden="true">·</span>
          <a class="qs-plain-link" href={searchHref}>搜索</a>
          <span aria-hidden="true">·</span>
          <span>Powered by Astro · Tailwind · Pagefind</span>
        </p>
      </div>
    </footer>

    <script is:inline define:vars={{ searchHref }}>
      const root = document.documentElement;

      function syncThemeControl(isDark) {
        const button = document.querySelector("[data-theme-toggle]");
        if (!button) return;
        button.setAttribute("aria-pressed", String(isDark));
        const label = isDark ? "切换至浅色模式" : "切换至深色模式";
        button.setAttribute("aria-label", label);
        button.setAttribute("title", label);
      }

      function applyTheme(isDark) {
        window.__siteTheme = isDark ? "dark" : "light";
        root.classList.toggle("dark", isDark);
        root.dataset.theme = isDark ? "dark" : "light";
        root.style.colorScheme = isDark ? "dark" : "light";
        document.querySelector("meta[data-theme-color]")?.setAttribute("content", isDark ? "#0A0A0A" : "#FAFAFA");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {}
        syncThemeControl(isDark);
      }

      function setupChrome() {
        syncThemeControl(root.classList.contains("dark"));

        const toggle = document.querySelector("[data-theme-toggle]");
        if (toggle && !toggle.dataset.bound) {
          toggle.dataset.bound = "true";
          toggle.addEventListener("click", () => applyTheme(!root.classList.contains("dark")));
        }

        const menuToggle = document.querySelector("[data-menu-toggle]");
        const drawer = document.querySelector("[data-mobile-nav]");
        if (menuToggle && drawer && !menuToggle.dataset.bound) {
          menuToggle.dataset.bound = "true";
          menuToggle.addEventListener("click", () => {
            const open = drawer.classList.toggle("is-open");
            menuToggle.setAttribute("aria-expanded", String(open));
            menuToggle.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
          });
          drawer.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
              drawer.classList.remove("is-open");
              menuToggle.setAttribute("aria-expanded", "false");
            });
          });
        }
      }

      document.addEventListener("astro:page-load", setupChrome);
      setupChrome();

      if (!window.__shortcutBound) {
        window.__shortcutBound = true;
        window.addEventListener("keydown", (event) => {
          if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;
          const target = event.target;
          const tag = target instanceof HTMLElement ? target.tagName : "";
          if (tag === "INPUT" || tag === "TEXTAREA" || (target instanceof HTMLElement && target.isContentEditable)) return;
          event.preventDefault();
          window.location.href = searchHref;
        });
      }
    </script>
  </body>
</html>
