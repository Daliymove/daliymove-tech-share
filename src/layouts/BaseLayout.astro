---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import { absoluteUrl, defaultImageHeight, defaultImagePath, defaultImageWidth, withBase } from "../lib/posts";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  canonicalPath?: string;
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title,
  description = site.description,
  image = withBase(defaultImagePath),
  imageAlt,
  imageWidth,
  imageHeight,
  type = "website",
  canonicalPath,
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  articleTags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const currentPath = Astro.url.pathname;
const homeHref = withBase("/");
const searchHref = withBase("/search/");
const faviconSvgHref = withBase("/favicon.svg");
const faviconPngHref = withBase("/favicon.png");
const logoHref = withBase("/images/logo-marks/folded-path.svg");
const rssHref = withBase("/rss.xml");
const routePath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/") || "/";
const canonical = absoluteUrl(canonicalPath ?? routePath);
const ogPath = image.replace(import.meta.env.BASE_URL, "/") || defaultImagePath;
const ogImage = image.startsWith("http") ? image : absoluteUrl(ogPath);
const ogImageAlt = imageAlt ?? `${title ?? site.title} 的分享图`;
const usesDefaultImage = image === withBase(defaultImagePath);
const ogImageWidth = imageWidth ?? (usesDefaultImage ? defaultImageWidth : undefined);
const ogImageHeight = imageHeight ?? (usesDefaultImage ? defaultImageHeight : undefined);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F5F6F3" data-theme-color />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconSvgHref} />
    <link rel="alternate icon" type="image/png" sizes="144x144" href={faviconPngHref} />
    <link rel="apple-touch-icon" sizes="144x144" href={faviconPngHref} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={rssHref} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {type === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {type === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {type === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {type === "article" && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <ClientRouter />
    <title>{pageTitle}</title>
    <script is:inline>
      const themeRoot = document.documentElement;
      const motionPreferenceReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      themeRoot.classList.toggle("motion-ready", !motionPreferenceReduced);
      let savedTheme = null;
      try {
        savedTheme = localStorage.getItem("theme");
      } catch {}
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const runtimeTheme = window.__siteTheme;
      const isDarkTheme = runtimeTheme ? runtimeTheme === "dark" : savedTheme ? savedTheme === "dark" : prefersDark;
      window.__siteTheme = isDarkTheme ? "dark" : "light";
      themeRoot.classList.toggle("dark", isDarkTheme);
      themeRoot.dataset.theme = isDarkTheme ? "dark" : "light";
      themeRoot.style.colorScheme = isDarkTheme ? "dark" : "light";
      document.querySelector("meta[data-theme-color]")?.setAttribute("content", isDarkTheme ? "#08150C" : "#F5F6F3");
      // 进站首屏编排：仅整页加载时启用；SPA 切换由 View Transition 负责（after-swap 移除）
      if (!window.__entranceQueued) {
        window.__entranceQueued = true;
        themeRoot.classList.add("is-entering");
      }
    </script>
  </head>
  <body>
      <div id="page-loading-bar" class="page-loading-bar" aria-hidden="true"></div>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header sticky top-0 z-40 px-3 pt-3 md:px-5">
      <div class="header-shell mx-auto max-w-7xl rounded-2xl border border-white/80 bg-white/75 px-3 py-2.5 sm:px-4 sm:py-3 shadow-soft backdrop-blur-2xl transition-all duration-300 dark:border-white/10 dark:bg-ink-950/75">
        <div class="header-row flex items-center justify-between gap-2 sm:gap-4">
          <a class="header-brand group flex min-w-0 items-center gap-2.5 sm:gap-3" href={homeHref} aria-label={`${site.title} 首页`}>
            <span class="brand-mark h-9 w-9 sm:h-11 sm:w-11 shrink-0 rounded-xl transition-all duration-300 group-hover:scale-105 group-hover:shadow-[0_4px_16px_-2px_rgba(79,122,98,0.28)]" aria-hidden="true">
              <img src={logoHref} alt="" class="transition-transform duration-300 group-hover:rotate-3" />
            </span>
            <span class="header-brand-copy min-w-0">
              <span class="header-brand-title block truncate text-sm font-semibold tracking-wide text-ink-950 transition-colors duration-200 group-hover:text-leaf-700 dark:text-ink-50 dark:group-hover:text-leaf-300">{site.title}</span>
              <span class="header-brand-tagline hidden text-xs text-ink-500 sm:block dark:text-ink-300">{site.tagline}</span>
            </span>
          </a>
          <nav class="header-nav-desktop hidden items-center gap-1 rounded-full border border-ink-200/70 bg-white/65 p-1 lg:flex dark:border-white/10 dark:bg-white/5" aria-label="主导航">
            <span class="nav-spotlight" aria-hidden="true"></span>
            <span class="nav-hover-pill" aria-hidden="true"></span>
            <span class="nav-active-pill" aria-hidden="true"></span>
            {site.nav.map((item) => {
              const href = withBase(item.href);
              const active = currentPath === href || (item.href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  class:list={[
                    "nav-item inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium",
                    active && "is-active"
                  ]}
                  href={href}
                  aria-current={active ? "page" : undefined}
                >
                  <Icon name={item.icon} class="nav-icon h-3.5 w-3.5 opacity-80" />
                  <span class="nav-label">{item.label}</span>
                  <span class="nav-active-pip" aria-hidden="true" />
                </a>
              );
            })}
          </nav>
          <div class="header-actions flex items-center gap-1.5 sm:gap-2">
            <a class="utility-icon-button group/search" href={searchHref} aria-label="搜索文章">
              <Icon name="search" class="h-4 w-4 shrink-0" />
              <span class="utility-tooltip" role="tooltip" aria-hidden="true">
                <span>搜索</span>
                <kbd class="utility-kbd">Ctrl K</kbd>
              </span>
            </a>
            <a class="utility-icon-button hidden sm:inline-flex group/rss" href={rssHref} aria-label="RSS 订阅">
              <Icon name="rss" class="h-4 w-4 shrink-0" />
              <span class="utility-tooltip" role="tooltip" aria-hidden="true">
                <span>RSS 订阅</span>
              </span>
            </a>
            <button class="theme-toggle-switch" type="button" aria-label="切换至深色模式" aria-pressed="false">
              <span class="theme-switch-track" aria-hidden="true">
                <span class="track-sun"><Icon name="sun" class="h-3 w-3" /></span>
                <span class="track-moon"><Icon name="moon" class="h-3 w-3" /></span>
              </span>
              <span class="theme-switch-thumb" aria-hidden="true">
                <span class="thumb-icon-light"><Icon name="sun" class="h-3 w-3" /></span>
                <span class="thumb-icon-dark"><Icon name="moon" class="h-3 w-3" /></span>
              </span>
              <span class="utility-tooltip" role="tooltip" aria-hidden="true">
                <span class="theme-tooltip-text">切换至深色模式</span>
              </span>
            </button>
            <button class="mobile-menu-toggle utility-icon-button lg:hidden" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu-drawer">
              <span class="menu-icon-open"><Icon name="menu" class="h-4 w-4" /></span>
              <span class="menu-icon-close hidden"><Icon name="close" class="h-4 w-4" /></span>
            </button>
          </div>
        </div>

        {/* 移动端下拉/折叠菜单 */}
        <div id="mobile-menu-drawer" class="mobile-menu-drawer hidden lg:hidden border-t border-ink-200/70 pt-3 mt-3 dark:border-white/10">
          <nav class="grid grid-cols-2 min-[380px]:grid-cols-3 gap-2" aria-label="移动端导航">
            {site.nav.map((item, idx) => {
              const href = withBase(item.href);
              const active = currentPath === href || (item.href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  class:list={[
                    "mobile-nav-link flex flex-col items-center justify-center gap-1.5 rounded-xl py-2.5 text-xs font-medium transition-all duration-200",
                    active
                      ? "bg-leaf-600/12 text-leaf-800 border border-leaf-600/25 shadow-sm font-semibold dark:bg-leaf-400/15 dark:text-leaf-200 dark:border-leaf-400/25"
                      : "bg-ink-100/70 text-ink-700 hover:bg-ink-200/70 dark:bg-white/5 dark:text-ink-200 dark:hover:bg-white/10"
                  ]}
                  style={`--mobile-idx: ${idx};`}
                  href={href}
                  aria-current={active ? "page" : undefined}
                >
                  <Icon name={item.icon} class="h-4 w-4" />
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
          <div class="mt-3 flex items-center justify-between border-t border-ink-200/40 pt-2.5 text-xs text-ink-500 dark:border-white/5 dark:text-ink-400">
            <span>{site.tagline}</span>
            <a class="flex items-center gap-1 text-ink-600 hover:text-leaf-600 dark:text-ink-300 dark:hover:text-leaf-300" href={rssHref}>
              <Icon name="rss" class="h-3.5 w-3.5" />
              <span>RSS</span>
            </a>
          </div>
        </div>
      </div>
    </header>
    <main id="content" tabindex="-1" class="mx-auto min-h-[calc(100vh-13rem)] max-w-7xl px-5 py-10 md:py-14"><slot /></main>
    <footer class="px-5 pb-8 text-sm text-ink-500 dark:text-ink-300">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 rounded-2xl border border-white/60 bg-white/50 px-5 py-5 shadow-soft md:flex-row md:items-center md:justify-between dark:border-white/10 dark:bg-white/5">
        <div>
          <p class="font-medium text-ink-700 dark:text-ink-100">© {new Date().getFullYear()} {site.title}</p>
          <p class="mt-1">{site.tagline}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-ink-500 dark:text-ink-300">
          <a class="hover:text-leaf-700 dark:hover:text-leaf-300" href={rssHref}>RSS</a>
          <span>·</span>
          <a class="hover:text-leaf-700 dark:hover:text-leaf-300" href={searchHref}>搜索</a>
          <span>·</span>
          <span>Powered by Astro · Tailwind · Pagefind</span>
        </div>
      </div>
    </footer>
    <script is:inline define:vars={{ searchHref }}>
      const root = document.documentElement;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      
      function applyTheme(isDark) {
        const themeColor = document.querySelector("meta[data-theme-color]");
        window.__siteTheme = isDark ? "dark" : "light";
        root.classList.toggle("dark", isDark);
        root.dataset.theme = isDark ? "dark" : "light";
        root.style.colorScheme = isDark ? "dark" : "light";
        themeColor?.setAttribute("content", isDark ? "#08150C" : "#F5F6F3");
      }

      function syncIcon() {
        const button = document.querySelector(".theme-toggle-switch");
        const tooltipText = button?.querySelector(".theme-tooltip-text");
        const isDark = root.classList.contains("dark");
        button?.setAttribute("aria-pressed", String(isDark));
        const label = isDark ? "切换至浅色模式" : "切换至深色模式";
        button?.setAttribute("aria-label", label);
        if (tooltipText) tooltipText.textContent = label;
      }

      // Delegate the click with View Transitions circular ripple reveal
      if (!window.__siteThemeControllerInstalled) {
        window.__siteThemeControllerInstalled = true;
        document.addEventListener("click", async (event) => {
          const button = event.target instanceof Element ? event.target.closest(".theme-toggle-switch") : null;
          if (!(button instanceof HTMLButtonElement)) return;

          const isDark = root.classList.contains("dark");
          const next = !isDark;
          const rect = button.getBoundingClientRect();
          const x = rect.left + rect.width / 2;
          const y = rect.top + rect.height / 2;
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          const updateThemeState = () => {
            applyTheme(next);
            try {
              localStorage.setItem("theme", next ? "dark" : "light");
            } catch {}
            syncIcon();
          };

          // If reduced motion is requested, switch instantly
          if (reduceMotion) {
            updateThemeState();
            return;
          }

          let vtAnimated = false;
          if (typeof document.startViewTransition === "function") {
            // 主题圆形揭示期间挂起导航过渡动画（见 global.css 的 is-theme-transitioning 规则）。
            // 圆心/半径必须在 startViewTransition 之前写入，快照出现的第一帧即可用。
            root.classList.add("is-theme-transitioning");
            root.style.setProperty("--theme-reveal-x", `${x}px`);
            root.style.setProperty("--theme-reveal-y", `${y}px`);
            root.style.setProperty("--theme-reveal-r", `${endRadius}px`);
            try {
              const transition = document.startViewTransition(() => {
                updateThemeState();
              });
              // 圆形揭示由 CSS 动画 theme-circular-reveal 直接驱动（无 JS 启动间隙，不闪屏），
              // 这里只等待整场过渡结束后清理标记。
              vtAnimated = true;
              transition.finished
                .catch(() => {})
                .finally(() => {
                  root.classList.remove("is-theme-transitioning");
                  root.style.removeProperty("--theme-reveal-x");
                  root.style.removeProperty("--theme-reveal-y");
                  root.style.removeProperty("--theme-reveal-r");
                });
            } catch (err) {
              root.classList.remove("is-theme-transitioning");
              root.style.removeProperty("--theme-reveal-x");
              root.style.removeProperty("--theme-reveal-y");
              root.style.removeProperty("--theme-reveal-r");
              console.warn("ViewTransition fallback:", err);
            }
          }

          if (!vtAnimated) {
            // Fallback circular expanding overlay for other environments
            const circle = document.createElement("div");
            circle.className = "theme-ripple-circle";
            circle.style.left = `${x}px`;
            circle.style.top = `${y}px`;
            circle.style.width = `${endRadius * 2.2}px`;
            circle.style.height = `${endRadius * 2.2}px`;
            circle.style.backgroundColor = next ? "#08150C" : "#F5F6F3";
            document.body.appendChild(circle);

            // Force reflow
            void circle.offsetWidth;
            circle.style.transform = "translate(-50%, -50%) scale(1)";

            setTimeout(() => {
              updateThemeState();
              circle.style.opacity = "0";
              setTimeout(() => circle.remove(), 360);
            }, 220);
          }
        });
      }

      // Header Dynamic Glass Elevation on Scroll
      function initHeaderScroll() {
        const headerShell = document.querySelector(".site-header .header-shell");
        if (!(headerShell instanceof HTMLElement)) return;

        const syncScrollState = () => {
          const shell = document.querySelector(".site-header .header-shell");
          if (shell instanceof HTMLElement) {
            shell.classList.toggle("is-scrolled", window.scrollY > 16);
          }
        };

        // 滚动监听只绑定一次，避免每次页面切换累积监听器
        if (!window.__headerScrollBound) {
          window.__headerScrollBound = true;
          let ticking = false;
          window.addEventListener("scroll", () => {
            if (!ticking) {
              window.requestAnimationFrame(() => {
                syncScrollState();
                ticking = false;
              });
              ticking = true;
            }
          }, { passive: true });
        }
        syncScrollState();
      }

      // Organic Dual-Pill & Spotlight Controller for Desktop Nav
      function measureNavTarget(nav, target) {
        const navRect = nav.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        return {
          left: targetRect.left - navRect.left,
          width: targetRect.width,
        };
      }

      // 将激活胶囊对齐到当前激活项：
      // glide=true 且存在上一次位置时，从旧位置平滑滑入；否则直接落位（避免从左边缘飞入）
      function syncMagicPill(nav, glide = false) {
        const activePill = nav.querySelector(".nav-active-pill");
        if (!(activePill instanceof HTMLElement)) return;

        const activeLink = nav.querySelector('.nav-item[aria-current="page"]');
        if (!(activeLink instanceof HTMLElement)) {
          activePill.style.opacity = "0";
          window.__navPillPos = null;
          return;
        }

        const target = measureNavTarget(nav, activeLink);
        const last = window.__navPillPos;
        const canGlide = glide && !reduceMotion && !!last && Math.abs(last.left - target.left) > 0.5;

        activePill.style.transition = "none";
        if (canGlide) {
          activePill.style.width = `${last.width}px`;
          activePill.style.transform = `translate3d(${last.left}px, 0, 0)`;
        } else {
          activePill.style.width = `${target.width}px`;
          activePill.style.transform = `translate3d(${target.left}px, 0, 0)`;
        }
        activePill.style.opacity = "1";
        // 强制回流后再恢复过渡，保证“无动画落位”生效
        void activePill.offsetWidth;
        activePill.style.transition = "";

        if (canGlide) {
          window.requestAnimationFrame(() => {
            activePill.style.width = `${target.width}px`;
            activePill.style.transform = `translate3d(${target.left}px, 0, 0)`;
          });
        }
        window.__navPillPos = target;
      }

      function initMagicPill() {
        const nav = document.querySelector(".header-nav-desktop");
        if (!(nav instanceof HTMLElement)) return;

        const activePill = nav.querySelector(".nav-active-pill");
        const hoverPill = nav.querySelector(".nav-hover-pill");
        const spotlight = nav.querySelector(".nav-spotlight");
        const links = Array.from(nav.querySelectorAll(".nav-item"));
        const getActiveLink = () => nav.querySelector('.nav-item[aria-current="page"]');

        const setPillLayout = (pill, target, visible = true) => {
          if (!(pill instanceof HTMLElement)) return;
          if (!visible || !(target instanceof HTMLElement)) {
            pill.style.opacity = "0";
            return;
          }
          const { left, width } = measureNavTarget(nav, target);
          pill.style.width = `${width}px`;
          pill.style.transform = `translate3d(${left}px, 0, 0)`;
          pill.style.opacity = "1";
        };

        // 事件只绑定一次（同一 DOM 元素），避免初始脚本与 astro:page-load 双重注册
        if (!nav.dataset.pillBound) {
          nav.dataset.pillBound = "true";

          links.forEach((link) => {
            link.addEventListener("mouseenter", () => {
              const activeLink = getActiveLink();
              if (link === activeLink) {
                setPillLayout(hoverPill, null, false);
                if (activePill instanceof HTMLElement && activeLink) {
                  activePill.style.opacity = "1";
                }
              } else {
                setPillLayout(hoverPill, link, true);
                if (activePill instanceof HTMLElement) {
                  activePill.style.opacity = "0.4";
                }
              }
            });
          });

          nav.addEventListener("mouseleave", () => {
            setPillLayout(hoverPill, null, false);
            if (spotlight instanceof HTMLElement) {
              spotlight.style.opacity = "0";
            }
            if (activePill instanceof HTMLElement && getActiveLink()) {
              activePill.style.opacity = "1";
            }
          });

          nav.addEventListener("mousemove", (e) => {
            if (!(spotlight instanceof HTMLElement)) return;
            const rect = nav.getBoundingClientRect();
            nav.style.setProperty("--nav-mouse-x", `${e.clientX - rect.left}px`);
            nav.style.setProperty("--nav-mouse-y", `${e.clientY - rect.top}px`);
            spotlight.style.opacity = "1";
          });
        }

        // hover pill 初始隐藏
        setPillLayout(hoverPill, null, false);

        // 跨页切换：从上一页激活位平滑滑到新激活位
        syncMagicPill(nav, true);

        // 布局刷新（resize / 字体加载完成）只绑定一次
        if (!window.__navPillLayoutBound) {
          window.__navPillLayoutBound = true;
          window.addEventListener("resize", () => {
            const currentNav = document.querySelector(".header-nav-desktop");
            if (currentNav instanceof HTMLElement) {
              syncMagicPill(currentNav);
            }
          }, { passive: true });
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(() => {
              const currentNav = document.querySelector(".header-nav-desktop");
              if (currentNav instanceof HTMLElement) {
                syncMagicPill(currentNav);
              }
            });
          }
        }
      }

      function setMobileMenuState(open) {
        const toggle = document.querySelector(".mobile-menu-toggle");
        const drawer = document.getElementById("mobile-menu-drawer");
        if (!toggle || !drawer) return;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
        drawer.classList.toggle("hidden", !open);
        toggle.querySelector(".menu-icon-open")?.classList.toggle("hidden", open);
        toggle.querySelector(".menu-icon-close")?.classList.toggle("hidden", !open);
      }

      function setupMobileMenu() {
        const toggle = document.querySelector(".mobile-menu-toggle");
        const drawer = document.getElementById("mobile-menu-drawer");
        if (!toggle || !drawer) return;

        // 状态由 DOM 属性驱动，事件只绑定一次
        if (!toggle.dataset.menuBound) {
          toggle.dataset.menuBound = "true";
          toggle.addEventListener("click", (e) => {
            e.stopPropagation();
            setMobileMenuState(toggle.getAttribute("aria-expanded") !== "true");
          });
          drawer.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", () => setMobileMenuState(false));
          });
        }

        if (!window.__mobileMenuDocBound) {
          window.__mobileMenuDocBound = true;
          document.addEventListener("click", (e) => {
            const currentToggle = document.querySelector(".mobile-menu-toggle");
            const currentDrawer = document.getElementById("mobile-menu-drawer");
            if (!currentDrawer || currentDrawer.classList.contains("hidden")) return;
            if (currentDrawer.contains(e.target)) return;
            if (currentToggle && currentToggle.contains(e.target)) return;
            setMobileMenuState(false);
          });
        }
      }

      function initHeaderChrome() {
        applyTheme(window.__siteTheme === "dark");
        syncIcon();
        setupMobileMenu();
        initHeaderScroll();
        initMagicPill();
      }
      document.addEventListener("astro:page-load", initHeaderChrome);
      initHeaderChrome();

      // Top Page Transition Loading Bar (Kova Smooth Navigation)
      const loadingBar = document.getElementById("page-loading-bar");
      let finishTimeout = null;

      document.addEventListener("astro:before-preparation", () => {
        window.__spaNav = true;
        // 立即结束进站编排，避免新页 header 在切换帧里重播沉降动画
        root.classList.remove("is-entering");
        if (finishTimeout) clearTimeout(finishTimeout);
        loadingBar?.classList.remove("is-finishing");
        loadingBar?.classList.add("is-active");
      });

      // after-swap 发生在新页快照捕获之前：此处的 DOM 状态会写入过渡帧
      document.addEventListener("astro:after-swap", () => {
        window.__spaNav = true;
        root.classList.remove("is-entering");

        // 首屏内容立即定格显现（无过渡），保证快照帧完整；下方内容仍走滚动显现
        root.classList.add("is-swap-capture");
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add("is-revealed");
          }
        });
        // 导航胶囊立即对齐新激活项，快照帧即正确
        const nav = document.querySelector(".header-nav-desktop");
        if (nav instanceof HTMLElement) syncMagicPill(nav, false);
        requestAnimationFrame(() => root.classList.remove("is-swap-capture"));

        loadingBar?.classList.remove("is-active");
        loadingBar?.classList.add("is-finishing");
        finishTimeout = setTimeout(() => {
          loadingBar?.classList.remove("is-finishing");
        }, 560);
      });

      // Smooth Blur & FadeUp Intersection Observer
      function initReveals() {
        const revealElements = Array.from(document.querySelectorAll("[data-reveal]:not(.is-revealed)"));
        if (reduceMotion || !("IntersectionObserver" in window)) {
          revealElements.forEach((element) => element.classList.add("is-revealed"));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -4% 0px", threshold: 0.02 },
          );
          revealElements.forEach((element) => revealObserver.observe(element));
        }
      }

      initReveals();
      document.addEventListener("astro:page-load", initReveals);



      window.addEventListener("keydown", (event) => {
        const key = event.key.toLowerCase();
        const isShortcut = (event.metaKey || event.ctrlKey) && key === "k";
        if (!isShortcut) return;
        const target = event.target;
        const tag = target instanceof HTMLElement ? target.tagName : "";
        if (tag === "INPUT" || tag === "TEXTAREA" || (target instanceof HTMLElement && target.isContentEditable)) {
          if (!window.location.pathname.includes("/search")) return;
        }
        event.preventDefault();
        if (window.location.pathname.includes("/search")) {
          document.querySelector("#search-input")?.focus();
          return;
        }
        document.querySelector(`a[href="${searchHref}"]`)?.click();
      });
    </script>
  </body>
</html>
