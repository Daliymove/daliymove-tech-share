---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectTags, getAllPosts, getTagUrl } from "../../lib/posts";

const posts = await getAllPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签">
  <PageHeader title="标签" eyebrow="Tags" description="标签更像是思考时留下的线索，用来串起不同文章之间的联系。" />
  <div class="mt-10 flex flex-wrap gap-x-6 gap-y-4 border-y border-line py-6">
    {tags.map(([tag, count]) => (
      <a class="qs-tag" href={getTagUrl(tag)}>#{tag} <span class="qs-index-count ml-1">{count}</span></a>
    ))}
  </div>
</BaseLayout>
