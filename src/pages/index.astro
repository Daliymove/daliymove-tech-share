---
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectCategories, collectTags, getAllPosts, getCategoryUrl, getPostUrl, getReadingTime, getTagUrl, sortPostsByPublicationDate, withBase } from "../lib/posts";

const posts = await getAllPosts();
const allCategories = collectCategories(posts);
const allTags = collectTags(posts);
const latest = sortPostsByPublicationDate(posts).slice(0, 6);
const lead = latest[0];
const rest = latest.slice(1);
const categories = allCategories.slice(0, 6);
const tags = allTags.slice(0, 12);
const shortDate = (date: Date) => new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" }).format(date).replace("/", ".");
const heroDescription = "记录技术实践，分享可复用的方法。";
---

<BaseLayout>
  <!-- Lead：左对齐的主要阅读轴 -->
  <section class="max-w-4xl pb-16 pt-6 md:pb-24 md:pt-12">
    <p class="qs-eyebrow">技术笔记 / 持续更新 · {new Date().getFullYear()}</p>
    <h1 class="mt-6 font-display text-4xl font-semibold leading-[1.08] tracking-[-0.02em] text-ink-primary md:text-5xl lg:text-6xl">
      把知识沉淀成分享
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-8 text-ink-secondary">{heroDescription}</p>
    <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
      <a class="qs-link font-medium" href={withBase("/blog/")}>开始阅读 <span aria-hidden="true">→</span></a>
      <a class="qs-plain-link" href={withBase("/about/")}>关于 daliyMove</a>
    </div>
    <p class="qs-meta mt-12 border-t border-line pt-4">{posts.length} 篇文章 · {allCategories.length} 个分类 · {allTags.length} 个标签</p>
  </section>

  <hr class="qs-rule" />

  <!-- 01 最近更新：非对称信息岛，不是等权卡片网格 -->
  <section class="py-14 md:py-16" aria-labelledby="latest-heading">
    <div class="qs-section-head">
      <div>
        <p class="qs-eyebrow">01 / Latest</p>
        <h2 id="latest-heading" class="qs-section-title mt-3">最近更新</h2>
      </div>
      <a class="qs-plain-link text-sm" href={withBase("/blog/")}>查看全部 →</a>
    </div>

    <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      {lead && (
        <article class="lg:pr-8">
          <p class="qs-meta">{shortDate(lead.data.pubDate)} · {lead.data.category} · {getReadingTime(lead.body)}</p>
          <h3 class="mt-5 font-display text-3xl font-semibold leading-[1.2] text-ink-primary md:text-4xl">
            <a class="transition-colors hover:text-signal-primary" href={getPostUrl(lead)}>{lead.data.title}</a>
          </h3>
          <p class="mt-5 max-w-xl text-base leading-8 text-ink-secondary">{lead.data.description}</p>
          <a class="qs-plain-link mt-7 inline-block text-sm" href={getPostUrl(lead)}>阅读全文 →</a>
        </article>
      )}

      <div>
        {rest.map((post) => (
          <a class="group flex items-baseline gap-4 border-t border-line py-3 last:border-b" href={getPostUrl(post)}>
            <span class="qs-meta w-12 shrink-0">{shortDate(post.data.pubDate)}</span>
            <span class="min-w-0 flex-1 text-[0.95rem] leading-snug text-ink-primary transition-colors group-hover:text-signal-primary">{post.data.title}</span>
            <span class="qs-meta shrink-0" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <hr class="qs-rule" />

  <!-- 02 索引：细线分组，不用胶囊墙 -->
  <section class="py-14 md:py-16" aria-labelledby="index-heading">
    <div class="qs-section-head">
      <div>
        <p class="qs-eyebrow">02 / Index</p>
        <h2 id="index-heading" class="qs-section-title mt-3">按主题查阅</h2>
      </div>
    </div>

    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <p class="qs-eyebrow mb-4">知识分类</p>
        {categories.map(([category, count]) => (
          <a class="qs-index-row" href={getCategoryUrl(category)}>
            <span class="qs-index-name">{category}</span>
            <span class="qs-index-count">{count} 篇</span>
          </a>
        ))}
        <a class="qs-plain-link mt-5 inline-block text-sm" href={withBase("/categories/")}>全部分类 →</a>
      </div>

      <div>
        <p class="qs-eyebrow mb-4">常用标签</p>
        <div class="flex flex-wrap gap-x-5 gap-y-3 border-y border-line py-5">
          {tags.map(([tag]) => <a class="qs-tag" href={getTagUrl(tag)}>#{tag}</a>)}
        </div>
        <a class="qs-plain-link mt-5 inline-block text-sm" href={withBase("/tags/")}>全部标签 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
