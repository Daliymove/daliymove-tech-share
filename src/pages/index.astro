---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { collectCategories, collectTags, formatDate, getAllPosts, getCategoryUrl, getPostUrl, getReadingTime, getTagUrl, sortPostsByPublicationDate, withBase } from "../lib/posts";
import { getCategoryDefinition } from "../lib/categories";

const posts = await getAllPosts();
// 取消了主编领读区块后，置顶文章仍按发布时间进入最近更新，避免首页遗漏内容。
const latestCards = sortPostsByPublicationDate(posts).slice(0, 6).map((post) => ({
  post,
  url: getPostUrl(post),
  categoryColorClass: getCategoryDefinition(post.data.category).colorClass,
  dateLabel: new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" }).format(post.data.pubDate).replace("/", "."),
  dateTime: post.data.pubDate.toISOString(),
  readingTime: getReadingTime(post.body),
}));
const allCategories = collectCategories(posts);
const categories = allCategories.slice(0, 6);
const allTags = collectTags(posts);
const tags = allTags.slice(0, 12);
const heroDescription = "记录技术实践，分享可复用的方法。";
---

<BaseLayout>
  <!-- HERO：纯文字叙事 -->
  <section class="relative mx-auto max-w-5xl pb-4 pt-12 text-center sm:pt-16 md:pt-20">
    <div class="pointer-events-none absolute -top-12 left-1/2 -z-10 h-72 w-96 -translate-x-1/2 rounded-full bg-leaf-500/10 blur-[80px] dark:bg-leaf-400/15" style="animation: ambient-glow-pulse 6s ease-in-out infinite;" aria-hidden="true"></div>
    <h1 class="hero-title font-display text-4xl text-ink-900 dark:text-ink-50 md:text-6xl lg:text-[4rem]" data-reveal="title" style="--reveal-delay: 120ms">
      把知识沉淀成分享
    </h1>
    <p class="mx-auto mt-7 max-w-lg text-base leading-8 text-ink-600 dark:text-ink-300 md:text-lg" data-reveal style="--reveal-delay: 300ms">{heroDescription}</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal style="--reveal-delay: 420ms">
      <a class="inline-flex items-center gap-2 rounded-xl bg-leaf-600 px-5 py-3 text-sm font-semibold text-white shadow-lift transition hover:-translate-y-0.5 hover:bg-leaf-700 dark:bg-leaf-600 dark:text-white dark:hover:bg-leaf-500" href={withBase("/blog/")}>
        开始阅读
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a class="inline-flex items-center gap-2 rounded-xl border border-ink-200 bg-white/65 px-5 py-3 text-sm font-semibold text-ink-700 transition hover:border-leaf-300 hover:text-leaf-700 dark:border-white/10 dark:bg-white/5 dark:text-ink-100" href={withBase("/about/")}>
        <Icon name="user" class="h-4 w-4" />
        关于 daliyMove
      </a>
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-ink-500 dark:text-ink-300" data-reveal="soft" style="--reveal-delay: 520ms">
      <span class="inline-flex items-center gap-2"><strong class="text-lg text-ink-900 dark:text-ink-50">{posts.length}</strong>篇文章</span>
      <span class="inline-flex items-center gap-2"><strong class="text-lg text-ink-900 dark:text-ink-50">{allCategories.length}</strong>个分类</span>
      <span class="inline-flex items-center gap-2"><strong class="text-lg text-ink-900 dark:text-ink-50">{allTags.length}</strong>个标签</span>
    </div>
  </section>

  <!-- 最近更新：响应式文章卡片网格 -->
  <section class="pt-10 md:pt-12" aria-labelledby="latest-posts-heading">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-leaf-700 dark:text-leaf-300">Latest posts</p>
        <h2 id="latest-posts-heading" class="mt-1.5 font-display text-2xl font-semibold text-ink-900 dark:text-ink-50 md:text-3xl">最近更新</h2>
      </div>
      <div class="flex items-center gap-4">
        <span class="hidden font-mono text-xs text-ink-500 sm:inline dark:text-ink-300">按发布时间排序</span>
        <a class="inline-flex items-center gap-1 text-sm font-semibold text-leaf-700 transition-all hover:gap-2 dark:text-leaf-300" href={withBase("/blog/")}>
          查看全部
          <Icon name="arrow" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {latestCards.map((item, index) => (
        <article
          class="post-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/70 bg-white/75 p-5 shadow-soft hover:border-leaf-200 hover:shadow-lift focus-within:ring-2 focus-within:ring-leaf-500 focus-within:ring-offset-4 focus-within:ring-offset-paper-100 dark:border-white/10 dark:bg-white/[0.055] dark:hover:border-leaf-300/40 dark:focus-within:ring-offset-ink-950"
          data-reveal
          style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}
        >
          <span class:list={["absolute inset-x-0 top-0 h-0.5", item.categoryColorClass]} aria-hidden="true"></span>

          <div class="flex items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2">
              <span class="font-mono text-xs text-ink-400 dark:text-ink-400">{String(index + 1).padStart(2, "0")}</span>
              <span class="h-3 w-px bg-ink-200 dark:bg-white/10" aria-hidden="true"></span>
              <a class="inline-flex min-w-0 items-center gap-1.5 truncate text-xs font-medium text-ink-500 transition hover:text-leaf-700 dark:text-ink-300 dark:hover:text-leaf-300" href={getCategoryUrl(item.post.data.category)}>
                <span class:list={["h-2 w-2 shrink-0 rounded-full", item.categoryColorClass]} aria-hidden="true"></span>
                {item.post.data.category}
              </a>
            </div>
            <time class="shrink-0 font-mono text-xs text-ink-500 dark:text-ink-300" datetime={item.dateTime} aria-label={`发布时间：${formatDate(item.post.data.pubDate)}`}>{item.dateLabel}</time>
          </div>

          <h3 class="post-card-heading mt-4 line-clamp-2 min-h-[3.4rem] font-display text-xl font-semibold leading-snug text-ink-950 transition group-hover:text-leaf-700 dark:text-ink-50 dark:group-hover:text-leaf-300">
            <a class="post-card-title-link" href={item.url}>{item.post.data.title}</a>
          </h3>

          <p class="mt-2 line-clamp-3 text-sm leading-6 text-ink-600 dark:text-ink-300">{item.post.data.description}</p>

          {item.post.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.post.data.tags.slice(0, 2).map((tag) => (
                <a class="max-w-[7.5rem] truncate rounded-full bg-ink-100/80 px-2.5 py-0.5 text-xs text-ink-500 transition hover:bg-leaf-100 hover:text-leaf-700 dark:bg-white/10 dark:text-ink-300 dark:hover:bg-leaf-300/10 dark:hover:text-leaf-200" href={getTagUrl(tag)}>#{tag}</a>
              ))}
            </div>
          )}

          <div class="mt-auto pt-5">
            <div class="flex items-center gap-2 border-t border-ink-200/60 pt-4 dark:border-white/10">
              <Icon name="clock" class="h-3.5 w-3.5 text-ink-400 dark:text-ink-400" />
              <span class="font-mono text-xs text-ink-500 dark:text-ink-300">{item.readingTime}</span>
              <a class="ml-auto inline-flex items-center gap-1 text-xs font-semibold text-leaf-700 dark:text-leaf-300" href={item.url} aria-label={`阅读文章：${item.post.data.title}`} data-post-read-link>
                阅读
                <Icon name="arrow" class="h-3.5 w-3.5" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 分类与标签：并列索引卡片 -->
  <section class="mt-10 grid gap-5 md:grid-cols-2" aria-label="内容索引">
    <div class="rounded-2xl border border-white/70 bg-white/60 p-5 shadow-soft dark:border-white/10 dark:bg-white/[0.035]" data-reveal>
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="inline-flex items-center gap-2 text-base font-semibold text-ink-900 dark:text-ink-50">
          <Icon name="grid" class="h-4 w-4 text-leaf-600 dark:text-leaf-300" />
          知识分类
        </h2>
        <a class="inline-flex items-center gap-1 text-xs text-leaf-700 hover:underline dark:text-leaf-300" href={withBase("/categories/")}>全部 <Icon name="arrow" class="h-3 w-3" /></a>
      </div>
      <div class="grid gap-1">
        {categories.map(([category, count]) => (
          <a class="group flex items-center justify-between rounded-xl border border-transparent px-3 py-2 text-sm transition hover:border-leaf-200 hover:bg-leaf-50 dark:hover:border-leaf-300/30 dark:hover:bg-leaf-300/10" href={getCategoryUrl(category)}>
            <span class="flex items-center gap-3">
              <span class:list={["h-2.5 w-2.5 rounded-full", getCategoryDefinition(category).colorClass]} aria-hidden="true"></span>
              <span class="text-ink-700 dark:text-ink-200">{category}</span>
            </span>
            <span class="font-mono text-xs text-ink-500 transition group-hover:text-leaf-700 dark:text-ink-300 dark:group-hover:text-leaf-300">{count}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="rounded-2xl border border-white/70 bg-white/60 p-5 shadow-soft dark:border-white/10 dark:bg-white/[0.035]" data-reveal style="--reveal-delay: 80ms">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="inline-flex items-center gap-2 text-base font-semibold text-ink-900 dark:text-ink-50">
          <Icon name="tag" class="h-4 w-4 text-leaf-600 dark:text-leaf-300" />
          常用标签
        </h2>
        <a class="inline-flex items-center gap-1 text-xs text-leaf-700 hover:underline dark:text-leaf-300" href={withBase("/tags/")}>全部 <Icon name="arrow" class="h-3 w-3" /></a>
      </div>
      <div class="flex flex-wrap gap-2">
        {tags.map(([tag, count]) => (
          <a class="inline-flex items-center max-lg:min-h-11 rounded-full border border-ink-200/80 bg-white/55 px-3 py-1.5 text-xs text-ink-600 transition hover:border-leaf-300 hover:bg-leaf-50 hover:text-leaf-700 dark:border-white/10 dark:bg-white/5 dark:text-ink-200 dark:hover:bg-leaf-300/10 dark:hover:text-leaf-200" href={getTagUrl(tag)}>
            #{tag} <span class="font-mono text-ink-500 dark:text-ink-300">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
