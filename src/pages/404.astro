---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/posts";
---

<BaseLayout title="页面不存在" noindex>
  <section class="max-w-2xl py-16 md:py-24">
    <p class="qs-eyebrow">404 / Not found</p>
    <h1 class="mt-6 font-display text-4xl font-semibold leading-tight text-ink-primary md:text-5xl">这页暂时还没有写出来</h1>
    <p class="mt-5 text-base leading-8 text-ink-secondary">可能是链接变了，也可能是一篇未来会补上的技术笔记。</p>
    <a class="qs-link mt-9 inline-block text-sm" href={withBase("/")}>回到首页 →</a>
  </section>
</BaseLayout>
