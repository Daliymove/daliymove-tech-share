---
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getAllPosts, getPostUrl } from "../lib/posts";

const posts = await getAllPosts();
const includeBodyInLocalIndex = import.meta.env.DEV;
const localSearchIndex = posts.map((post) => {
  return {
    title: post.data.title,
    description: post.data.description,
    category: post.data.category,
    tags: post.data.tags,
    url: getPostUrl(post),
    date: formatDate(post.data.pubDate),
    pinned: post.data.pinned,
    body: includeBodyInLocalIndex ? (post.body ?? "").replace(/\s+/g, " ").trim() : "",
  };
});
const localSearchIndexJson = JSON.stringify(localSearchIndex).replace(/</g, "\\u003c");
---

<BaseLayout title="搜索" noindex>
  <PageHeader title="搜索" eyebrow="Search" description="支持全文搜索。构建后优先使用 Pagefind 索引；开发模式下会自动回退到本地文章索引。" />

  <section class="mt-10 max-w-3xl">
    <label class="qs-eyebrow mb-3 block" for="search-input">输入关键词</label>
    <div class="relative">
      <input id="search-input" class="search-input pr-24" type="search" placeholder="例如：Astro、学习系统、Markdown" autocomplete="off" spellcheck="false" aria-controls="search-results" aria-describedby="search-status search-summary" />
      <button id="search-clear" class="qs-plain-link absolute right-3 top-1/2 hidden -translate-y-1/2 text-xs" type="button" aria-label="清空搜索词">清空</button>
    </div>

    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2" role="group" aria-label="常用搜索词">
      {["Astro", "Markdown", "学习", "复盘", "知识管理"].map((keyword) => (
        <button class="search-chip" type="button" data-query={keyword}>{keyword}</button>
      ))}
    </div>

    <p id="search-status" class="qs-meta mt-8" role="status" aria-live="polite" aria-atomic="true">输入关键词后加载完整搜索索引。</p>
    <p id="search-summary" class="qs-meta mt-2"><span id="search-count" class="qs-signal">0</span> 条结果</p>

    <div id="search-results" class="mt-6" aria-busy="false" aria-labelledby="search-status"></div>
  </section>

  <script is:inline id="local-search-index" type="application/json" set:html={localSearchIndexJson} />

  <script>
    let cleanupSearch = () => {};

    function initializeSearch() {
    cleanupSearch();

    type LocalSearchItem = {
      title: string;
      description: string;
      category: string;
      tags: string[];
      url: string;
      date: string;
      pinned: boolean;
      body: string;
    };

    type SearchResultItem = {
      title: string;
      excerpt: string;
      url: string;
      date?: string;
      category?: string;
      pinned?: boolean;
      source: "pagefind" | "local";
    };

    const input = document.querySelector("#search-input") as HTMLInputElement | null;
    const clearButton = document.querySelector("#search-clear") as HTMLButtonElement | null;
    const results = document.querySelector<HTMLElement>("#search-results");
    const status = document.querySelector("#search-status");
    const count = document.querySelector("#search-count");
    const chips = document.querySelectorAll<HTMLButtonElement>(".search-chip");
    const pagefindPath = `${import.meta.env.BASE_URL}/pagefind/pagefind.js`.replace(/\/{2,}/g, "/");
    const localIndexNode = document.querySelector("#local-search-index");
    if (!input || !results || !localIndexNode) return;

    const searchController = new AbortController();
    const { signal } = searchController;

    let pagefind: any;
    let pagefindReady = false;
    let pagefindFailed = false;
    let searchTimer: number | undefined;
    let searchToken = 0;
    let engineLabel = "本地索引";
    cleanupSearch = () => {
      searchController.abort();
      window.clearTimeout(searchTimer);
      searchToken += 1;
    };

    type HistoryMode = "push" | "replace" | "none";

    const localIndex: LocalSearchItem[] = (() => {
      try {
        return JSON.parse(localIndexNode?.textContent || "[]") as LocalSearchItem[];
      } catch {
        return [];
      }
    })();

    function setStatus(message: string) {
      if (status) status.textContent = message;
    }

    function setCount(value: number) {
      if (count) count.textContent = String(value);
    }

    function setResultsBusy(isBusy: boolean) {
      results?.setAttribute("aria-busy", String(isBusy));
    }

    function updateClearButton() {
      clearButton?.classList.toggle("hidden", !input?.value.trim());
    }

    function escapeHtml(value: unknown) {
      const element = document.createElement("div");
      element.textContent = String(value ?? "未命名文章");
      return element.innerHTML;
    }

    function escapeAttribute(value: unknown) {
      return String(value ?? "").replace(/[&<>"]/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
      }[char] ?? char));
    }

    // Pagefind may return highlighted excerpts as HTML. Preserve only its
    // simple <mark> wrapper; escape everything else before it reaches the
    // result template.
    function sanitizeExcerpt(value: unknown) {
      return escapeHtml(value)
        .replace(/&lt;mark&gt;/gi, "<mark>")
        .replace(/&lt;\/mark&gt;/gi, "</mark>");
    }

    function renderLoadingSkeleton() {
      if (!results) return;
      setResultsBusy(true);
      results.innerHTML = Array.from({ length: 3 })
        .map(() => `
          <div class="qs-result-row">
            <div class="skeleton-shimmer h-4 w-1/3"></div>
            <div class="skeleton-shimmer mt-3 h-3 w-full"></div>
            <div class="skeleton-shimmer mt-2 h-3 w-4/5"></div>
          </div>
        `)
        .join("");
    }

    function renderEmpty(title: string, description: string) {
      if (!results) return;
      setResultsBusy(false);
      results.innerHTML = `
        <div class="qs-empty">
          <h2 class="font-display text-xl font-semibold text-ink-primary">${escapeHtml(title)}</h2>
          <p class="mt-2 text-sm leading-7 text-ink-secondary">${escapeHtml(description)}</p>
        </div>
      `;
    }

    function renderResults(items: SearchResultItem[], total: number, elapsed: number, query: string) {
      if (!results) return;
      setResultsBusy(false);
      setCount(total);

      if (!items.length) {
        setStatus(`没有找到“${query}”的匹配内容。`);
        renderEmpty("没有匹配结果", "换一个更短的关键词试试，比如文章主题、工具名或分类名。");
        return;
      }

      setStatus(`找到 ${total} 条结果，用时 ${elapsed}ms（${engineLabel}）。`);
      results.innerHTML = items.map((item, index) => `
        <a class="qs-result-row" href="${escapeAttribute(item.url)}">
          <div class="qs-meta mb-2">${String(index + 1).padStart(2, "0")} · ${item.pinned ? "置顶 · " : ""}${item.category ? escapeHtml(item.category) + " · " : ""}${item.date ? escapeHtml(item.date) : ""}</div>
          <h2 class="qs-result-title">${escapeHtml(item.title)}</h2>
          <p class="mt-2 text-sm leading-7 text-ink-secondary">${sanitizeExcerpt(item.excerpt || "没有可显示的摘要。")}</p>
          <p class="qs-meta mt-2 truncate">${escapeHtml(item.url)}</p>
        </a>
      `).join("");
    }

    function normalize(text: string) {
      return text.toLowerCase().replace(/\s+/g, " ").trim();
    }

    function buildTokens(query: string) {
      const normalized = normalize(query);
      if (!normalized) return [] as string[];

      const tokens = new Set<string>([normalized]);
      normalized.split(/[\s,，。.!！?？;；:：/\\|]+/).filter(Boolean).forEach((token) => tokens.add(token));

      // Chinese-friendly partial matching: add 2-char and 3-char windows.
      const compact = normalized.replace(/\s+/g, "");
      if (/[\u4e00-\u9fa5]/.test(compact)) {
        for (let size = 2; size <= 3; size += 1) {
          for (let i = 0; i <= compact.length - size; i += 1) {
            tokens.add(compact.slice(i, i + size));
          }
        }
      }

      return Array.from(tokens).filter(Boolean);
    }

    function makeExcerpt(text: string, query: string, fallback = "") {
      const source = text || fallback || "没有可显示的摘要。";
      const normalizedSource = source;
      const token = buildTokens(query)[0] || query;
      const index = normalize(normalizedSource).indexOf(normalize(token));
      if (index < 0) {
        return escapeHtml(source.slice(0, 96)) + (source.length > 96 ? "..." : "");
      }

      const start = Math.max(0, index - 24);
      const end = Math.min(source.length, index + token.length + 48);
      const snippet = `${start > 0 ? "..." : ""}${source.slice(start, end)}${end < source.length ? "..." : ""}`;
      const safe = escapeHtml(snippet);
      const highlight = escapeHtml(source.slice(index, index + token.length));
      return safe.replace(highlight, `<mark>${highlight}</mark>`);
    }

    function searchLocal(query: string): SearchResultItem[] {
      const tokens = buildTokens(query);
      if (!tokens.length) return [];

      const scored = localIndex.map((item) => {
        const fields = [
          { text: item.title, weight: 12 },
          { text: item.tags.join(" "), weight: 8 },
          { text: item.category, weight: 7 },
          { text: item.description, weight: 5 },
          { text: item.body, weight: 2 },
        ];

        let score = 0;
        for (const field of fields) {
          const haystack = normalize(field.text);
          for (const token of tokens) {
            if (haystack.includes(normalize(token))) {
              score += field.weight;
            }
          }
          if (haystack.includes(normalize(query))) {
            score += field.weight * 2;
          }
        }

        return { item, score };
      })
        .filter((entry) => entry.score > 0)
        .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title, "zh-CN"));

      return scored.slice(0, 12).map(({ item }) => ({
        title: item.title,
        url: item.url,
        date: item.date,
        category: item.category,
        pinned: item.pinned,
        excerpt: makeExcerpt(item.description || item.body, query, item.description),
        source: "local" as const,
      }));
    }

    async function loadPagefind() {
      if (pagefindReady) return pagefind;
      if (pagefindFailed) return null;

      try {
        pagefind = await import(/* @vite-ignore */ pagefindPath);
        await pagefind.options({ excerptLength: 24 });
        pagefindReady = true;
        engineLabel = "Pagefind";
        setStatus("索引已就绪。输入关键词即可搜索标题、摘要和正文。");
        return pagefind;
      } catch {
        pagefindFailed = true;
        engineLabel = "本地索引";
        setStatus(`Pagefind 索引未找到，已切换到本地文章索引（共 ${localIndex.length} 篇）。`);
        return null;
      }
    }

    async function searchPagefind(query: string): Promise<SearchResultItem[] | null> {
      const engine = await loadPagefind();
      if (!engine) return null;

      try {
        const search = await engine.search(query);
        const data = await Promise.all(search.results.slice(0, 10).map((result: any) => result.data()));
        return data.map((item: any) => {
          const itemUrl = String(item.url ?? "");
          const localMeta = itemUrl ? localIndex.find((entry) => itemUrl === entry.url || itemUrl.endsWith(entry.url) || entry.url.endsWith(itemUrl)) : undefined;
          return {
            title: item.meta?.title ?? localMeta?.title ?? item.url ?? "未命名文章",
            excerpt: item.excerpt || "没有可显示的摘要。",
            url: itemUrl,
            date: localMeta?.date,
            category: localMeta?.category,
            pinned: localMeta?.pinned,
            source: "pagefind" as const,
          };
        });
      } catch {
        pagefindFailed = true;
        pagefindReady = false;
        engineLabel = "本地索引";
        return null;
      }
    }

    function updateSearchUrl(query: string, mode: Exclude<HistoryMode, "none">) {
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set("q", query);
      } else {
        url.searchParams.delete("q");
      }
      if (url.href === window.location.href) return;
      window.history[mode === "push" ? "pushState" : "replaceState"](null, "", url);
    }

    async function runSearch(query: string, historyMode: HistoryMode = "replace") {
      const trimmed = query.trim();
      const token = ++searchToken;
      updateClearButton();
      setCount(0);

      if (historyMode !== "none") {
        updateSearchUrl(trimmed, historyMode);
      }

      if (!results) return;
      setResultsBusy(true);
      results.innerHTML = "";

      if (!trimmed) {
        setStatus(pagefindReady
          ? "索引已就绪。输入关键词即可搜索标题、摘要和正文。"
          : `本地文章索引已就绪（共 ${localIndex.length} 篇），也可以在构建后使用 Pagefind。`);
        renderEmpty("开始一次搜索", "可以搜索技术关键词、文章标题、分类线索，或者点击上方常用搜索词。");
        return;
      }

      setStatus(`正在搜索“${trimmed}”...`);
      renderLoadingSkeleton();
      const startedAt = performance.now();

      let items = await searchPagefind(trimmed);
      if (token !== searchToken) return;

      // Fallback when Pagefind is unavailable or returns no Chinese-friendly matches.
      if (!items || items.length === 0) {
        engineLabel = pagefindReady ? "本地索引（补充）" : "本地索引";
        items = searchLocal(trimmed);
      } else {
        engineLabel = "Pagefind";
      }

      if (token !== searchToken) return;
      const elapsed = Math.max(1, Math.round(performance.now() - startedAt));
      renderResults(items, items.length, elapsed, trimmed);
    }

    function queueSearch() {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => runSearch(input?.value ?? ""), 160);
    }

    input.addEventListener("input", queueSearch, { signal });
    clearButton?.addEventListener("click", () => {
      if (!input) return;
      input.value = "";
      input.focus();
      runSearch("");
    }, { signal });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (!input) return;
        input.value = chip.dataset.query ?? "";
        input.focus();
        runSearch(input.value, "push");
      }, { signal });
    });

    const initialQuery = new URL(window.location.href).searchParams.get("q")?.trim() ?? "";
    if (input) input.value = initialQuery;
    updateClearButton();
    if (initialQuery) {
      void runSearch(initialQuery, "none");
    } else {
      renderEmpty("开始一次搜索", "可以搜索技术关键词、文章标题、分类线索，或者点击上方常用搜索词。");
    }

    window.addEventListener("popstate", () => {
      const query = new URL(window.location.href).searchParams.get("q")?.trim() ?? "";
      if (input) input.value = query;
      void runSearch(query, "none");
    }, { signal });
    }

    document.addEventListener("astro:before-swap", () => cleanupSearch());
    document.addEventListener("astro:page-load", initializeSearch);
    initializeSearch();
  </script>
</BaseLayout>
