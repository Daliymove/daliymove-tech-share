---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectCategories, getAllPosts, getCategoryUrl } from "../../lib/posts";

const posts = await getAllPosts();
const categories = collectCategories(posts);
---

<BaseLayout title="分类">
  <PageHeader title="分类" eyebrow="Categories" description="按知识领域整理文章，让长期积累有一个清楚的抽屉。" />
  <div class="mt-10">
    {categories.map(([category, count]) => (
      <a class="qs-index-row" href={getCategoryUrl(category)}>
        <span class="qs-index-name">{category}</span>
        <span class="qs-index-count">{count} 篇</span>
      </a>
    ))}
  </div>
</BaseLayout>
